---
import fs from 'node:fs';
import path from 'node:path';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  authorRole?: string;
  category?: string;
  categoryColor?: string;
  readingTime?: string;
  level?: string;
  heroImage?: string;
  headings?: { text: string; slug: string }[];
  related?: any[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'Yassine Oulada',
  authorRole = 'GEO & SEO Spezialist',
  category = 'GEO',
  categoryColor = '#e2552a',
  readingTime,
  level,
  heroImage,
  headings = [],
  related = [],
} = Astro.props;

const dateFormatted = new Intl.DateTimeFormat('de-DE', {
  year: 'numeric', month: 'long', day: 'numeric'
}).format(pubDate);

const updatedFormatted = updatedDate ? new Intl.DateTimeFormat('de-DE', {
  year: 'numeric', month: 'long', day: 'numeric'
}).format(updatedDate) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Echtes Autorenfoto verwenden, sobald es existiert (Build-Zeit-Check)
const authorPhotoPath = '/images/yassine-oulada.jpg';
const hasAuthorPhoto = fs.existsSync(path.join(process.cwd(), 'public', authorPhotoPath));

// Inhaltsverzeichnis nur bei längeren Artikeln anzeigen
const showToc = headings.length >= 4;
---
<Base title={title} description={description} ogImage={heroImage}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": heroImage ? new URL(heroImage.replace(/\.svg$/, '.png'), Astro.site).toString() : undefined,
      "datePublished": pubDate.toISOString(),
      "dateModified": (updatedDate || pubDate).toISOString(),
      "author": {
        "@type": "Person",
        "name": "Yassine Oulada",
        "jobTitle": authorRole,
        "url": "https://simplygeo.de/about",
        "sameAs": ["https://www.linkedin.com/in/yassine-o-726988196/"]
      },
      "publisher": {
        "@type": "Organization",
        "name": "SimplyGEO",
        "url": "https://simplygeo.de",
        "logo": {
          "@type": "ImageObject",
          "url": "https://simplygeo.de/images/og-default.png"
        }
      },
      "url": canonicalURL,
      "inLanguage": "de-DE"
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://simplygeo.de/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://simplygeo.de/blog" },
        { "@type": "ListItem", "position": 3, "name": title, "item": canonicalURL.toString() }
      ]
    })} />
  </Fragment>

  <Header />

  <div class="read-progress" aria-hidden="true"></div>

  <main id="main" class="blog-main">
    <article class="blog-article">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Start</a>
        <span>›</span>
        <a href="/blog">Blog</a>
        <span>›</span>
        <span>{title}</span>
      </nav>

      <!-- Hero Image -->
      {heroImage && (
        <img src={heroImage} alt={title} class="hero-image" loading="eager" />
      )}

      <!-- Meta -->
      <div class="article-meta">
        {category && (
          <span class="meta-chip" style={`color: ${categoryColor}; border-color: ${categoryColor}33; background: ${categoryColor}18;`}>
            {category}
          </span>
        )}
        {level && <span class="meta-chip">{level}</span>}
        {readingTime && <span class="meta-chip"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3 2"/></svg> {readingTime}</span>}
      </div>

      <!-- Title -->
      <h1 class="article-title">{title}</h1>
      <p class="article-desc">{description}</p>

      <!-- Author row -->
      <div class="author-row">
        {hasAuthorPhoto
          ? <img src={authorPhotoPath} alt="Yassine Oulada" class="author-avatar author-photo" width="36" height="36" />
          : <div class="author-avatar">YA</div>
        }
        <div class="author-meta">
          <span class="author-name">{author}</span>
          <span class="author-date">
            {authorRole} · {dateFormatted}
            {updatedFormatted && <span class="updated"> · Aktualisiert: {updatedFormatted}</span>}
          </span>
        </div>
      </div>

      <hr class="article-divider" />

      <!-- Inhaltsverzeichnis -->
      {showToc && (
        <nav class="toc" aria-label="Inhaltsverzeichnis">
          <div class="toc-label">Inhalt</div>
          <ol class="toc-list">
            {headings.map(h => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <!-- Content -->
      <div class="prose">
        <slot />
      </div>

      <!-- Über den Autor -->
      <div class="author-box">
        {hasAuthorPhoto
          ? <img src={authorPhotoPath} alt="Yassine Oulada" class="author-box-avatar author-box-photo" width="56" height="56" />
          : <div class="author-box-avatar">YA</div>
        }
        <div class="author-box-content">
          <div class="author-box-name">Yassine Oulada</div>
          <div class="author-box-role">GEO & SEO Spezialist · Performance Marketing Manager</div>
          <p class="author-box-bio">
            Yassine Oulada ist Performance Marketing Manager mit mehrjähriger Berufs- und
            Agenturerfahrung, spezialisiert auf SEO, SEA und Website-Relaunches.
            Er hat zahlreiche B2B-Unternehmen betreut, von regionalen Mittelständlern bis zu
            internationalen Websites, und erschließt sich GEO gerade systematisch. Auf SimplyGEO
            dokumentiert er offen, was er dabei lernt: ohne Buzzwords und ohne erfundene Erfolgsgeschichten.
          </p>
          <a href="/about" class="author-box-link">Mehr über Yassine →</a>
        </div>
      </div>

      <!-- Weiterlesen -->
      {related.length > 0 && (
        <div class="related">
          <h2 class="related-title">Weiterlesen</h2>
          <div class="related-grid">
            {related.map((r: any) => (
              <a href={`/blog/${r.slug}`} class="related-card">
                {r.heroImage && (
                  <div class="rc-thumb"><img src={r.heroImage} alt={r.title} loading="lazy" /></div>
                )}
                <div class="rc-body">
                  <span class="rc-cat" style={`color:${r.categoryColor || 'var(--accent)'}`}>{r.category}</span>
                  <span class="rc-title">{r.title}</span>
                  {r.readingTime && <span class="rc-time"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3 2"/></svg> {r.readingTime}</span>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back link -->
      <div class="article-footer">
        <a href="/blog" class="back-link">← Zurück zum Blog</a>
      </div>

    </article>
  </main>

  <Footer />
</Base>

<style>
/* Lesefortschritt — reines CSS, wird in nicht unterstützenden Browsern ausgeblendet */
.read-progress {
  position: fixed; top: 56px; left: 0; right: 0; height: 2px;
  z-index: 250;
  background: linear-gradient(90deg, var(--accent), var(--mango));
  transform-origin: 0 50%;
  transform: scaleX(0);
  animation: read-grow linear;
  animation-timeline: scroll();
}
@keyframes read-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@supports not (animation-timeline: scroll()) {
  .read-progress { display: none; }
}

.blog-main {
  position: relative; z-index: 1;
  padding: 32px 20px 60px;
}
.blog-article { max-width: 720px; margin: 0 auto; }

.breadcrumb {
  display: flex; align-items: center; gap: 7px;
  font-family: var(--font-mono);
  font-size: 0.72rem; color: var(--muted);
  margin-bottom: 24px;
}
.breadcrumb a:hover { color: var(--accent-deep); }
.breadcrumb span { color: var(--muted2); }

.hero-image {
  width: 100%;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  margin-bottom: 30px;
  aspect-ratio: 1200/630;
  object-fit: cover;
}

.article-meta { display: flex; gap: 7px; flex-wrap: wrap; align-items: center; margin-bottom: 18px; }
.meta-chip {
  font-family: var(--font-mono);
  font-size: 0.66rem; font-weight: 500;
  padding: 3px 9px; border-radius: 4px;
  border: 1px solid var(--border2); color: var(--muted);
  display: inline-flex; align-items: center; gap: 4px;
}

.article-title {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 4.4vw, 2.7rem);
  font-weight: 700; letter-spacing: -0.035em;
  line-height: 1.1; color: var(--navy);
  margin-bottom: 16px;
}
.article-desc {
  font-size: 1.12rem; color: var(--muted);
  line-height: 1.6; margin-bottom: 24px;
}

.author-row {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 24px;
}
.author-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--purple));
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-size: 0.8rem; font-weight: 700; color: #1a365d;
  flex-shrink: 0;
}
.author-photo { object-fit: cover; background: none; }
.author-name { font-size: 0.85rem; font-weight: 600; color: var(--navy); display: block; }
.author-date { font-family: var(--font-mono); font-size: 0.68rem; color: var(--muted); }
.updated { color: var(--green); }

.article-divider { border: none; border-top: 1px solid var(--border); margin-bottom: 32px; }

/* Inhaltsverzeichnis */
.toc {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  margin-bottom: 32px;
}
.toc-label {
  font-family: var(--font-mono);
  font-size: 0.68rem; font-weight: 500; color: var(--accent-deep);
  margin-bottom: 12px;
}
.toc-list { list-style: none; counter-reset: toc; display: flex; flex-direction: column; gap: 6px; }
.toc-list li { counter-increment: toc; display: flex; gap: 10px; align-items: baseline; }
.toc-list li::before {
  content: counter(toc, decimal-leading-zero);
  font-family: var(--font-mono);
  font-size: 0.68rem; font-weight: 500; color: var(--accent-deep);
  flex-shrink: 0;
}
.toc-list a {
  font-size: 0.83rem; color: var(--muted);
  transition: color 0.15s;
}
.toc-list a:hover { color: var(--accent); }

/* Über den Autor Box */
.author-box {
  display: flex; gap: 20px; align-items: flex-start;
  margin-top: 48px;
  padding: 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.author-box-avatar {
  width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--purple));
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-size: 1rem; font-weight: 700; color: #1a365d;
}
.author-box-photo { object-fit: cover; background: none; }
.author-box-content { flex: 1; }
.author-box-name {
  font-family: var(--font-display);
  font-size: 1rem; font-weight: 700; color: var(--text);
  margin-bottom: 2px;
}
.author-box-role { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent-deep); margin-bottom: 10px; }
.author-box-bio { font-size: 0.85rem; color: var(--muted); line-height: 1.65; margin-bottom: 12px; }
.author-box-link { font-size: 0.8rem; color: var(--accent); font-weight: 600; transition: opacity 0.15s; }
.author-box-link:hover { opacity: 0.8; }

@media (max-width: 480px) {
  .author-box { flex-direction: column; }
}

/* Weiterlesen */
.related { margin-top: 40px; }
.related-title {
  font-family: var(--font-display);
  font-size: 1.15rem; font-weight: 700; color: var(--text);
  margin-bottom: 14px;
}
.related-grid { display: grid; gap: 10px; }
@media (min-width: 640px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
.related-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-sm); overflow: hidden;
  display: flex; flex-direction: column;
  transition: border-color 0.15s, transform 0.15s;
}
.related-card:hover { border-color: var(--border2); transform: translateY(-2px); }
.rc-thumb { aspect-ratio: 16/9; overflow: hidden; }
.rc-thumb img { width: 100%; height: 100%; object-fit: cover; }
.rc-body { padding: 12px; display: flex; flex-direction: column; gap: 5px; flex: 1; }
.rc-cat { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 500; }
.rc-title { font-family: var(--font-display); font-size: 0.86rem; font-weight: 600; color: var(--navy); line-height: 1.32; flex: 1; }
.rc-time { font-family: var(--font-mono); font-size: 0.64rem; color: var(--muted2); }

.article-footer { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border); }
.back-link { font-family: var(--font-mono); font-size: 0.76rem; color: var(--muted); transition: color 0.15s; }
.back-link:hover { color: var(--accent-deep); }
</style>
