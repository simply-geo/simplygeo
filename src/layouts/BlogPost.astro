---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  authorRole?: string;
  category?: string;
  categoryColor?: string;
  readingTime?: string;
  level?: string;
  heroImage?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'Yassine Oulada',
  authorRole = 'GEO & SEO Spezialist',
  category = 'GEO',
  categoryColor = '#00c2ff',
  readingTime,
  level,
  heroImage,
} = Astro.props;

const dateFormatted = new Intl.DateTimeFormat('de-DE', {
  year: 'numeric', month: 'long', day: 'numeric'
}).format(pubDate);

const updatedFormatted = updatedDate ? new Intl.DateTimeFormat('de-DE', {
  year: 'numeric', month: 'long', day: 'numeric'
}).format(updatedDate) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<Base title={title} description={description} ogImage={heroImage}>
  <script type="application/ld+json" slot="head">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": heroImage ? new URL(heroImage, Astro.site).toString() : undefined,
      "datePublished": pubDate.toISOString(),
      "dateModified": (updatedDate || pubDate).toISOString(),
      "author": {
        "@type": "Person",
        "name": "Yassine Oulada",
        "jobTitle": authorRole,
        "url": "https://simplygeo.de/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "SimplyGEO",
        "url": "https://simplygeo.de"
      },
      "url": canonicalURL,
      "inLanguage": "de-DE"
    })}
  </script>

  <Header />

  <main class="blog-main">
    <article class="blog-article">

      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Start</a>
        <span>›</span>
        <a href="/blog">Blog</a>
        <span>›</span>
        <span>{title}</span>
      </nav>

      <!-- Hero Image -->
      {heroImage && (
        <img src={heroImage} alt={title} class="hero-image" loading="eager" />
      )}

      <!-- Meta -->
      <div class="article-meta">
        {category && (
          <span class="meta-chip" style={`color: ${categoryColor}; border-color: ${categoryColor}33; background: ${categoryColor}18;`}>
            {category}
          </span>
        )}
        {level && <span class="meta-chip">{level}</span>}
        {readingTime && <span class="meta-chip">⏱ {readingTime}</span>}
      </div>

      <!-- Title -->
      <h1 class="article-title">{title}</h1>
      <p class="article-desc">{description}</p>

      <!-- Author row -->
      <div class="author-row">
        <div class="author-avatar">YA</div>
        <div class="author-meta">
          <span class="author-name">{author}</span>
          <span class="author-date">
            {authorRole} · {dateFormatted}
            {updatedFormatted && <span class="updated"> · Aktualisiert: {updatedFormatted}</span>}
          </span>
        </div>
      </div>

      <hr class="article-divider" />

      <!-- Content -->
      <div class="prose">
        <slot />
      </div>

      <!-- Über den Autor -->
      <div class="author-box">
        <div class="author-box-avatar">YA</div>
        <div class="author-box-content">
          <div class="author-box-name">Yassine Oulada</div>
          <div class="author-box-role">GEO & SEO Spezialist · Online Marketing Manager · Freelancer</div>
          <p class="author-box-bio">
            Yassine Oulada ist Online Marketing Manager bei PixelProduction und Freelancer im DACH-Markt.
            Er spezialisiert sich auf Generative Engine Optimization (GEO), SEO und Website-Relaunches
            für B2B-Unternehmen. Auf SimplyGEO teilt er praxisnahes Wissen zur KI-Suche — ohne Buzzwords,
            mit echten Ergebnissen.
          </p>
          <a href="/about" class="author-box-link">Mehr über Yassine →</a>
        </div>
      </div>

      <!-- Back link -->
      <div class="article-footer">
        <a href="/blog" class="back-link">← Zurück zum Blog</a>
      </div>

    </article>
  </main>

  <Footer />
</Base>

<style>
.blog-main {
  position: relative; z-index: 1;
  padding: 32px 20px 60px;
}
.blog-article { max-width: 720px; margin: 0 auto; }

.breadcrumb {
  display: flex; align-items: center; gap: 6px;
  font-size: 0.72rem; color: var(--muted);
  margin-bottom: 20px;
}
.breadcrumb a:hover { color: var(--accent); }
.breadcrumb span { color: var(--muted2); }

.hero-image {
  width: 100%;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  margin-bottom: 28px;
  aspect-ratio: 1200/630;
  object-fit: cover;
}

.article-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
.meta-chip {
  font-size: 0.65rem; font-weight: 600;
  padding: 3px 9px; border-radius: 20px;
  border: 1px solid var(--border); color: var(--muted);
  text-transform: uppercase; letter-spacing: 0.06em;
}

.article-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(1.7rem, 4vw, 2.4rem);
  font-weight: 700; letter-spacing: -0.03em;
  line-height: 1.15; color: var(--text);
  margin-bottom: 12px;
}
.article-desc {
  font-size: 1rem; color: var(--muted);
  line-height: 1.65; margin-bottom: 20px;
}

.author-row {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 24px;
}
.author-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--purple));
  display: flex; align-items: center; justify-content: center;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.8rem; font-weight: 700; color: #070d1a;
  flex-shrink: 0;
}
.author-name { font-size: 0.82rem; font-weight: 600; color: var(--text); display: block; }
.author-date { font-size: 0.72rem; color: var(--muted); }
.updated { color: var(--muted2); }

.article-divider { border: none; border-top: 1px solid var(--border); margin-bottom: 32px; }

/* Über den Autor Box */
.author-box {
  display: flex; gap: 20px; align-items: flex-start;
  margin-top: 48px;
  padding: 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.author-box-avatar {
  width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent), var(--purple));
  display: flex; align-items: center; justify-content: center;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem; font-weight: 700; color: #070d1a;
}
.author-box-content { flex: 1; }
.author-box-name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem; font-weight: 700; color: var(--text);
  margin-bottom: 2px;
}
.author-box-role { font-size: 0.75rem; color: var(--accent); margin-bottom: 10px; }
.author-box-bio { font-size: 0.85rem; color: var(--muted); line-height: 1.65; margin-bottom: 12px; }
.author-box-link { font-size: 0.8rem; color: var(--accent); font-weight: 600; transition: opacity 0.15s; }
.author-box-link:hover { opacity: 0.8; }

@media (max-width: 480px) {
  .author-box { flex-direction: column; }
}

.article-footer { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border); }
.back-link { font-size: 0.82rem; color: var(--muted); transition: color 0.15s; }
.back-link:hover { color: var(--accent); }
</style>
