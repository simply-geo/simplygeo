---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const postModules = import.meta.glob('../../content/blog/*.md', { eager: true });
const posts = Object.values(postModules) as any[];
const sorted = posts.sort((a,b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
---
<Base title="Blog" description="Alle Artikel zu GEO, AEO und KI-Suche für den DACH-Markt.">
  <Header />
  <main class="blog-index">
    <div class="bi-header">
      <span class="eyebrow">Alle Artikel</span>
      <h1 class="bi-title">Blog</h1>
      <p class="bi-desc">Praxisnahes Wissen zu GEO, AEO und KI-gestützter Suche — für den DACH-Markt.</p>
    </div>
    <div class="posts-grid">
      {sorted.map((post: any) => (
        <a href={`/blog/${post.frontmatter.slug}`} class="post-card">
          <div class="pc-meta">
            {post.frontmatter.category && <span class="pc-cat" style={`color:${post.frontmatter.categoryColor||'var(--accent)'}`}>{post.frontmatter.category}</span>}
            {post.frontmatter.level && <span class="pc-level">{post.frontmatter.level}</span>}
          </div>
          <h2 class="pc-title">{post.frontmatter.title}</h2>
          <p class="pc-desc">{post.frontmatter.description}</p>
          <div class="pc-footer">
            <span class="pc-date">{new Intl.DateTimeFormat('de-DE',{year:'numeric',month:'short',day:'numeric'}).format(new Date(post.frontmatter.pubDate))}</span>
            {post.frontmatter.readingTime && <span class="pc-time">⏱ {post.frontmatter.readingTime}</span>}
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Base>
<style>
.blog-index{ position:relative; z-index:1; padding:40px 24px 60px; max-width:900px; margin:0 auto; }
.eyebrow{ font-size:0.67rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent); margin-bottom:8px; display:block; }
.bi-title{ font-family:'Space Grotesk',sans-serif; font-size:2rem; font-weight:700; letter-spacing:-0.02em; color:var(--text); margin-bottom:8px; }
.bi-desc{ font-size:0.88rem; color:var(--muted); margin-bottom:36px; }
.posts-grid{ display:grid; gap:10px; }
@media(min-width:640px){ .posts-grid{ grid-template-columns:repeat(2,1fr); } }
.post-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:20px; transition:border-color 0.15s,background 0.15s,transform 0.15s; }
.post-card:hover{ border-color:var(--border2); background:var(--surface2); transform:translateY(-2px); }
.pc-meta{ display:flex; gap:6px; margin-bottom:10px; }
.pc-cat{ font-size:0.65rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; }
.pc-level{ font-size:0.65rem; color:var(--muted); background:var(--border); padding:2px 7px; border-radius:20px; }
.pc-title{ font-family:'Space Grotesk',sans-serif; font-size:1rem; font-weight:700; color:var(--text); margin-bottom:8px; line-height:1.3; }
.pc-desc{ font-size:0.8rem; color:var(--muted); line-height:1.55; margin-bottom:14px; }
.pc-footer{ display:flex; gap:12px; align-items:center; }
.pc-date{ font-size:0.7rem; color:var(--muted2); }
.pc-time{ font-size:0.7rem; color:var(--muted); }
</style>
