---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const postModules = import.meta.glob('../../content/blog/*.md', { eager: true });
const posts = Object.values(postModules) as any[];
const sorted = posts.sort((a,b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
---
<Base title="Blog" description="Alle Artikel zu GEO, AEO und KI-Suche für den DACH-Markt von Yassine Oulada.">
  <Header />
  <main id="main" class="blog-index">
    <div class="bi-header">
      <span class="eyebrow">Alle Artikel</span>
      <h1 class="bi-title">Blog</h1>
      <p class="bi-desc">Praxisnahes Wissen zu GEO, AEO und KI-gestützter Suche für den DACH-Markt.</p>
      <div class="topic-chips">
        <a href="/themen/geo" class="topic-chip" style="--tc:#e2552a">GEO Grundlagen</a>
        <a href="/themen/aeo" class="topic-chip" style="--tc:#1a365d">AEO</a>
        <a href="/themen/llm" class="topic-chip" style="--tc:#2e6e8f">LLM & KI-Suche</a>
        <a href="/themen/schema" class="topic-chip" style="--tc:#b9871c">Strukturierte Daten</a>
        <a href="/themen/content" class="topic-chip" style="--tc:#a63d2f">Content & E-E-A-T</a>
        <a href="/themen/tools" class="topic-chip" style="--tc:#5c7186">Tools & Messung</a>
      </div>
    </div>
    <div class="posts-grid">
      {sorted.map((post: any) => (
        <a href={`/blog/${post.frontmatter.slug}`} class="post-card">
          {post.frontmatter.heroImage && (
            <div class="pc-thumb">
              <img src={post.frontmatter.heroImage} alt={post.frontmatter.title} loading="lazy" />
            </div>
          )}
          <div class="pc-body">
            <div class="pc-meta">
              {post.frontmatter.category && (
                <span class="pc-cat" style={`color:${post.frontmatter.categoryColor||'var(--accent)'}`}>
                  {post.frontmatter.category}
                </span>
              )}
              {post.frontmatter.level && <span class="pc-level">{post.frontmatter.level}</span>}
            </div>
            <h2 class="pc-title">{post.frontmatter.title}</h2>
            <p class="pc-desc">{post.frontmatter.description}</p>
            <div class="pc-author-row">
              <div class="pc-avatar">YA</div>
              <span class="pc-author-name">Yassine Oulada</span>
            </div>
            <div class="pc-footer">
              <span class="pc-date">
                {new Intl.DateTimeFormat('de-DE',{year:'numeric',month:'long',day:'numeric'}).format(new Date(post.frontmatter.pubDate))}
              </span>
              {post.frontmatter.readingTime && <span class="pc-time"><svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3 2"/></svg> {post.frontmatter.readingTime}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Base>
<style>
.blog-index{ position:relative; z-index:1; padding:40px 24px 60px; max-width:960px; margin:0 auto; }
.bi-title{ font-family:var(--font-display); font-size:2rem; font-weight:700; letter-spacing:-0.02em; color:var(--text); margin-bottom:8px; }
.bi-desc{ font-size:0.88rem; color:var(--muted); margin-bottom:18px; }
.topic-chips{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:36px; }
.topic-chip{ font-family:var(--font-mono);
  font-size:0.72rem; font-weight:500; color:var(--tc);
  padding:5px 12px; border-radius:20px;
  background:color-mix(in srgb, var(--tc) 9%, transparent);
  border:1px solid color-mix(in srgb, var(--tc) 22%, transparent);
  transition:background 0.15s, border-color 0.15s;
}
.topic-chip:hover{
  background:color-mix(in srgb, var(--tc) 16%, transparent);
  border-color:color-mix(in srgb, var(--tc) 40%, transparent);
}
.posts-grid{ display:grid; gap:12px; }
@media(min-width:640px){ .posts-grid{ grid-template-columns:repeat(2,1fr); } }
.post-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; display:flex; flex-direction:column; transition:border-color 0.15s,background 0.15s,transform 0.15s; }
.post-card:hover{ border-color:var(--border2); background:var(--surface2); transform:translateY(-2px); }
.pc-thumb{ aspect-ratio:16/9; overflow:hidden; }
.pc-thumb img{ width:100%; height:100%; object-fit:cover; }
.pc-body{ padding:18px; flex:1; display:flex; flex-direction:column; }
.pc-meta{ display:flex; gap:6px; margin-bottom:10px; align-items:center; }
.pc-cat{ font-family:var(--font-mono); font-size:0.66rem; font-weight:500; }
.pc-level{ font-family:var(--font-mono); font-size:0.62rem; color:var(--muted); background:var(--surface2); padding:2px 7px; border-radius:4px; }
.pc-title{ font-family:var(--font-display); font-size:1rem; font-weight:700; color:var(--text); margin-bottom:8px; line-height:1.3; }
.pc-desc{ font-size:0.8rem; color:var(--muted); line-height:1.55; margin-bottom:14px; flex:1; }
.pc-author-row{ display:flex; align-items:center; gap:7px; margin-bottom:10px; }
.pc-avatar{ width:24px; height:24px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--purple)); display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-size:0.58rem; font-weight:700; color:#1a365d; flex-shrink:0; }
.pc-author-name{ font-size:0.74rem; color:var(--muted); font-weight:500; }
.pc-footer{ display:flex; gap:12px; align-items:center; }
.pc-date{ font-family:var(--font-mono); font-size:0.66rem; color:var(--muted2); }
.pc-time{ font-family:var(--font-mono); font-size:0.66rem; color:var(--muted); }
</style>
