---
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/blog/*.md', { eager: true });
  return Object.entries(posts).map(([path, post]) => ({
    params: { slug: (post as any).frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props as any;
const { Content, frontmatter } = post;

// Inhaltsverzeichnis aus den H2-Überschriften
const headings = (post.getHeadings?.() ?? []).filter((h: any) => h.depth === 2);

// Weiterlesen: gleiche Kategorie zuerst, dann neueste andere
const allModules = import.meta.glob('../../content/blog/*.md', { eager: true });
const allPosts = (Object.values(allModules) as any[])
  .filter(p => p.frontmatter.slug !== frontmatter.slug);
const sameCategory = allPosts.filter(p => p.frontmatter.category === frontmatter.category);
const others = allPosts
  .filter(p => p.frontmatter.category !== frontmatter.category)
  .sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime());
const related = [...sameCategory, ...others].slice(0, 3).map(p => p.frontmatter);
---
<BlogPost
  title={frontmatter.title}
  description={frontmatter.description}
  pubDate={new Date(frontmatter.pubDate)}
  updatedDate={frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : undefined}
  author={frontmatter.author}
  authorRole={frontmatter.authorRole}
  category={frontmatter.category}
  categoryColor={frontmatter.categoryColor}
  readingTime={frontmatter.readingTime}
  level={frontmatter.level}
  heroImage={frontmatter.heroImage}
  headings={headings}
  related={related}
>
  <Content />
</BlogPost>
