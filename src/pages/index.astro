---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const icons: Record<string, string> = {
  geo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>`,
  aeo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>`,
  llm: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9 7V4M15 7V4M9 20v-3M15 20v-3M7 9H4M7 15H4M20 9h-3M20 15h-3"/></svg>`,
  schema: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4C6 4 6 6 6 7.5S6 11 4 12c2 1 2 3 2 4.5S6 20 8 20"/><path d="M16 4c2 0 2 2 2 3.5S18 11 20 12c-2 1-2 3-2 4.5s0 3.5-2 3.5"/></svg>`,
  content: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l3.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20z"/><path d="M13 6l3 3"/></svg>`,
  tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 19a9 9 0 1 1 14 0"/><path d="M12 13l4-4"/><circle cx="12" cy="14" r="1.4" fill="currentColor" stroke="none"/></svg>`,
};

const topics = [
  { id:'geo', label:'GEO Grundlagen', cat:'GEO Grundlagen', sub:'Was ist Generative Engine Optimization und warum klassisches SEO nicht mehr reicht.', color:'#e2552a' },
  { id:'aeo', label:'AEO & Answer Engines', cat:'AEO & Answer Engines', sub:'Optimierung für Featured Snippets, Voice Search und direkte KI-Antworten.', color:'#1a365d' },
  { id:'llm', label:'LLM & KI-Suchmaschinen', cat:'LLM & KI-Suchmaschinen', sub:'ChatGPT Search, Perplexity und Google AI Overviews verstehen und nutzen.', color:'#2e6e8f' },
  { id:'schema', label:'Strukturierte Daten', cat:'Strukturierte Daten', sub:'Schema Markup und maschinenlesbare Signale für KI-Antwortmaschinen.', color:'#b9871c' },
  { id:'content', label:'Content & E-E-A-T', cat:'Content & E-E-A-T', sub:'Vertrauen, Autorität und zitierfähige Inhalte als Grundlage für GEO-Erfolg.', color:'#a63d2f' },
  { id:'tools', label:'Tools & Messung', cat:'Tools & Messung', sub:'GEO-Erfolge sichtbar machen, messen und kontinuierlich verbessern.', color:'#5c7186' },
];

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const allPosts = Object.values(postModules) as any[];
const countFor = (cat: string) => allPosts.filter((p: any) => p.frontmatter.category === cat).length;
const latestPosts = allPosts
  .sort((a,b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
  .slice(0, 3);

const faqs = [
  {
    q: 'Was ist Generative Engine Optimization (GEO)?',
    a: 'GEO ist die Praxis, Websites und Inhalte so zu optimieren, dass sie von KI-gestützten Suchsystemen wie ChatGPT Search, Perplexity und Google AI Overviews als vertrauenswürdige Quelle erkannt und zitiert werden.',
  },
  {
    q: 'Brauche ich GEO zusätzlich zu SEO?',
    a: 'Ja: GEO ersetzt SEO nicht, sondern erweitert es. SEO bleibt das Fundament für organische Sichtbarkeit; GEO sorgt dafür, dass du auch in den generierten Antworten der KI-Systeme vorkommst, wo immer mehr Suchanfragen enden.',
  },
  {
    q: 'Welche KI-Suchsysteme sind im DACH-Markt relevant?',
    a: 'Die drei wichtigsten sind Google AI Overviews (wegen Googles Marktdominanz), ChatGPT Search (wegen der hohen Nutzung in der DACH-Region) und Perplexity AI (schnell wachsend, zitiert Quellen besonders sichtbar).',
  },
  {
    q: 'Wie lange dauert es, bis GEO Ergebnisse zeigt?',
    a: 'Nach gängigen Erfahrungsberichten sind erste messbare Erwähnungen in KI-Antworten nach etwa 90 Tagen realistisch, vorausgesetzt, die technische Basis stimmt und der Content wird konsequent nach GEO-Prinzipien aufgebaut.',
  },
  {
    q: 'Wo fange ich mit GEO am besten an?',
    a: 'Mit drei Maßnahmen: robots.txt für alle KI-Bots öffnen, Autorenprofile mit Schema Markup anlegen und bestehende Artikel so umschreiben, dass die wichtigste Antwort in den ersten Sätzen steht.',
  },
];
---
<Base title="GEO einfach erklärt: Sichtbar in ChatGPT, Perplexity & Google AI" description="SimplyGEO erklärt Generative Engine Optimization (GEO) auf Deutsch: praxisnah, kostenlos, ohne Buzzwords. So wird deine Website von ChatGPT, Perplexity und Google AI Overviews zitiert.">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "SimplyGEO",
      "url": "https://simplygeo.de",
      "logo": "https://simplygeo.de/images/og-default.png",
      "description": "Wissensplattform für Generative Engine Optimization (GEO), AEO und KI-Suche im DACH-Markt.",
      "founder": {
        "@type": "Person",
        "name": "Yassine Oulada",
        "jobTitle": "GEO & SEO Spezialist",
        "url": "https://simplygeo.de/about",
        "sameAs": ["https://www.linkedin.com/in/yassine-o-726988196/"]
      }
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main id="main">
  <section class="hero">
    <div class="hero-left">
      <span class="hero-eyebrow">Wissensplattform für GEO, AEO &amp; KI-Suche</span>
      <h1 class="hero-title">GEO einfach erklärt: So wird deine Website <em>von KI zitiert</em></h1>
      <p class="hero-desc">SimplyGEO zeigt dir, wie Generative Engine Optimization funktioniert und wie du in den Antworten von ChatGPT, Perplexity und Google AI Overviews sichtbar wirst. Praxisnah, kostenlos und auf Deutsch.</p>
      <div class="hero-cta">
        <a href="#topics" class="btn-primary">Jetzt GEO lernen →</a>
        <a href="/downloads/geo-checkliste.pdf" class="btn-secondary" download>
          <svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>
          GEO-Checkliste (PDF)
        </a>
      </div>
      <a href="/blog/was-ist-geo" class="hero-start">Neu hier? Starte mit dem Einstieg „Was ist GEO?" →</a>
    </div>
    <div class="hero-right">
      <!-- Mock LLM Chat Window -->
      <div class="mock-ai" aria-hidden="true">
        <div class="mock-ai-chrome">
          <span class="chrome-dot cd-red"></span>
          <span class="chrome-dot cd-yellow"></span>
          <span class="chrome-dot cd-green"></span>
          <span class="mock-ai-label">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.1 6.1L20 10l-5.9 1.9L12 18l-2.1-6.1L4 10l5.9-1.9L12 2z"/></svg>
            KI-Suche · Chat
          </span>
        </div>
        <div class="mock-ai-body">
          <div class="mock-user">
            <div class="mu-bubble">Was ist Generative Engine Optimization?</div>
          </div>
          <div class="mock-answer">
            <span class="ma-spark">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.1 6.1L20 10l-5.9 1.9L12 18l-2.1-6.1L4 10l5.9-1.9L12 2zM19 16l1 2.6L22.6 19.6 20 20.6 19 23.2 18 20.6 15.4 19.6 18 18.6 19 16z"/></svg>
            </span>
            <div class="ma-text">
              <p>Generative Engine Optimization (GEO) ist die Praxis, Inhalte so zu optimieren, dass sie von KI-Suchsystemen als vertrauenswürdige Quellen zitiert werden<span class="cite-chip">1</span>. Im Unterschied zu klassischem SEO geht es nicht um Rankings, sondern um <strong>Zitierbarkeit in KI-Antworten</strong>.</p>
            </div>
          </div>
          <div class="mock-sources">
            <span class="mock-sources-label">Quellen</span>
            <span class="source-chip active"><span class="sc-num">1</span>simplygeo.de</span>
            <span class="source-chip"><span class="sc-num">2</span>example-blog.de</span>
          </div>
        </div>
        <div class="mock-ai-input">
          <span class="mi-placeholder">Stell eine Folgefrage…</span>
          <span class="mi-send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="topics-section" id="topics">
    <div class="topics-header">
      <span class="eyebrow">Wissensbereiche</span>
      <h2 class="topics-title">Alle Themenbereiche</h2>
      <p class="topics-sub">Wähle einen Bereich und arbeite dich Schritt für Schritt durch.</p>
    </div>
    <div class="topics-grid">
      {topics.map(t => (
        <article class="topic-card" id={t.id} style={`--tc:${t.color}`}>
          <span class="tc-icon" set:html={icons[t.id]} />
          <h3 class="tc-title">{t.label}</h3>
          <p class="tc-desc">{t.sub}</p>
          <div class="tc-footer">
            <a href={`/themen/${t.id}`} class="tc-link">Zum Themenbereich →</a>
            <span class="tc-count">{countFor(t.cat)} {countFor(t.cat) === 1 ? 'Artikel' : 'Artikel'}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Neueste Artikel -->
  <section class="latest-section">
    <div class="latest-header">
      <div>
        <span class="eyebrow">Blog</span>
        <h2 class="latest-title">Neueste Artikel</h2>
      </div>
      <a href="/blog" class="latest-all">Alle Artikel →</a>
    </div>
    <div class="latest-grid">
      {latestPosts.map((post: any) => (
        <a href={`/blog/${post.frontmatter.slug}`} class="latest-card">
          {post.frontmatter.heroImage && (
            <div class="lc-thumb">
              <img src={post.frontmatter.heroImage} alt={post.frontmatter.title} loading="lazy" />
            </div>
          )}
          <div class="lc-body">
            <div class="lc-meta">
              {post.frontmatter.category && (
                <span class="lc-cat" style={`color:${post.frontmatter.categoryColor||'var(--accent)'}`}>
                  {post.frontmatter.category}
                </span>
              )}
              {post.frontmatter.level && <span class="lc-level">{post.frontmatter.level}</span>}
            </div>
            <h3 class="lc-title">{post.frontmatter.title}</h3>
            <p class="lc-desc">{post.frontmatter.description}</p>
            <div class="lc-footer">
              <div class="lc-author">
                <div class="lc-avatar">YA</div>
                <span>Yassine Oulada</span>
              </div>
              <span class="lc-date">
                {new Intl.DateTimeFormat('de-DE',{year:'numeric',month:'long',day:'numeric'}).format(new Date(post.frontmatter.pubDate))}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="latest-more">
      <a href="/blog" class="btn-secondary">Alle Artikel ansehen →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <span class="eyebrow">FAQ</span>
    <h2 class="faq-title">Häufige Fragen zu GEO</h2>
    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="dl-section">
    <div class="dl-inner">
      <div class="dl-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2.5h6v3H9z"/><path d="M9 11l1.5 1.5L13 10M9 16h6"/></svg>
      </div>
      <div class="dl-body">
        <h2 class="dl-title">Die kostenlose GEO-Checkliste</h2>
        <p class="dl-desc">36 Checkpunkte in 6 Bereichen. Direkt anwendbar für deine Website.</p>
      </div>
      <a href="/downloads/geo-checkliste.pdf" class="btn-primary" download>
        <svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>
        Jetzt herunterladen
      </a>
    </div>
  </section>
  </main>
  <Footer />
</Base>
<style>
.hero { background:var(--navy); position:relative; overflow:hidden; padding:44px 24px; }
@media(min-width:768px){ .hero{ display:grid; grid-template-columns:1.05fr 0.95fr; min-height:460px; padding:0; } }
.hero-left { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; }
@media(min-width:768px){ .hero-left{ padding:60px 52px; } }

/* Mono-Tag Eyebrow auf Navy */
.hero-eyebrow{
  display:inline-flex; align-items:center; gap:9px;
  font-family:var(--font-mono);
  font-size:0.73rem; font-weight:500; color:var(--mango);
  margin-bottom:22px;
}
.hero-eyebrow::before{ content:""; width:22px; height:1px; background:var(--mango); opacity:0.7; }

/* Headline */
.hero-title{ font-family:var(--font-display); font-size:clamp(2.1rem,4.2vw,3.15rem); font-weight:700; letter-spacing:-0.035em; line-height:1.08; color:var(--on-navy-text); margin-bottom:20px; }
.hero-title em{ font-style:normal; color:var(--accent); position:relative; white-space:nowrap; }
.hero-title em::after{ content:""; position:absolute; left:0; right:0; bottom:0.02em; height:0.09em; background:var(--mango); opacity:0.85; }

/* Description */
.hero-desc{ font-size:1rem; color:var(--on-navy-muted); line-height:1.7; max-width:480px; margin-bottom:30px; }

.hero-cta{ display:flex; gap:11px; flex-wrap:wrap; }

/* Einstiegslink */
.hero-start{
  display:inline-flex; align-items:center; gap:7px; margin-top:22px;
  font-family:var(--font-mono);
  font-size:0.76rem; color:var(--on-navy-muted);
  transition:color 0.15s;
}
.hero-start::before{ content:"→"; color:var(--mango); }
.hero-start:hover{ color:var(--on-navy-text); }
/* Sekundär-Button auf Navy: helle Variante */
.hero .btn-secondary{ color:var(--on-navy-text); border-color:rgba(245,240,225,0.35); }
.hero .btn-secondary:hover{ background:var(--almond); color:var(--navy); border-color:var(--almond); }

/* Right side — Mock LLM Chat Window (dunkles App-Fenster auf Navy) */
.hero-right{ display:none; }
@media(min-width:768px){ .hero-right{ display:flex; align-items:center; justify-content:center; padding:40px 40px 40px 0; } }

.mock-ai{
  --chat-bg:#14171d;
  --chat-border:rgba(245,240,225,0.11);
  --chat-panel:rgba(245,240,225,0.055);
  --chat-text:#cfd6de;
  width:100%; max-width:400px;
  background:var(--chat-bg); border:1px solid var(--chat-border);
  border-radius:12px; overflow:hidden;
  font-size:0.78rem;
  box-shadow:0 24px 60px rgba(0,0,0,0.45);
}
/* Fenster-Chrome */
.mock-ai-chrome{
  display:flex; align-items:center; gap:7px;
  padding:10px 14px; border-bottom:1px solid var(--chat-border);
}
.chrome-dot{ width:9px; height:9px; border-radius:50%; flex-shrink:0; opacity:0.9; }
.cd-red{ background:#ff5f57; } .cd-yellow{ background:#febc2e; } .cd-green{ background:#28c840; }
.mock-ai-label{
  display:inline-flex; align-items:center; gap:6px;
  margin-left:8px;
  font-family:var(--font-mono); font-size:0.66rem; font-weight:500; color:#8b95a1;
}
.mock-ai-label svg{ width:11px; height:11px; color:var(--mango); }
/* Chat-Verlauf */
.mock-ai-body{ padding:16px 14px 14px; display:flex; flex-direction:column; gap:14px; }
.mock-user{ display:flex; justify-content:flex-end; }
.mu-bubble{
  max-width:85%;
  background:var(--chat-panel); border:1px solid var(--chat-border);
  border-radius:12px 12px 3px 12px;
  padding:8px 12px;
  font-family:var(--font-display); font-size:0.84rem; font-weight:600; color:#e8e4d6;
}
.mock-answer{ display:flex; gap:10px; align-items:flex-start; }
.ma-spark{ flex-shrink:0; margin-top:1px; }
.ma-spark svg{ width:16px; height:16px; color:var(--mango); }
.ma-text p{ font-size:0.77rem; color:var(--chat-text); line-height:1.65; margin:0; }
.ma-text strong{ color:#f5f0e1; }
/* Inline-Zitatmarke */
.cite-chip{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:15px; height:15px; padding:0 3px; margin:0 1px 0 3px;
  border-radius:4px; vertical-align:2px;
  background:var(--accent); color:var(--navy);
  font-family:var(--font-mono); font-size:0.58rem; font-weight:700;
}
/* Quellen-Chips */
.mock-sources{ display:flex; align-items:center; flex-wrap:wrap; gap:7px; padding-left:26px; }
.mock-sources-label{ font-family:var(--font-mono); font-size:0.6rem; font-weight:500; color:#66707c; margin-right:2px; }
.source-chip{
  display:inline-flex; align-items:center; gap:6px;
  padding:4px 9px 4px 5px; border-radius:6px;
  border:1px solid var(--chat-border); background:var(--chat-panel);
  font-family:var(--font-mono); font-size:0.64rem; font-weight:500; color:#9aa5b0;
}
.source-chip .sc-num{
  width:15px; height:15px; border-radius:4px;
  display:flex; align-items:center; justify-content:center;
  background:rgba(245,240,225,0.1);
  font-size:0.56rem; font-weight:700; color:#9aa5b0;
}
.source-chip.active{
  border-color:rgba(255,110,64,0.5); background:rgba(255,110,64,0.12);
  color:#ffb59d;
}
.source-chip.active .sc-num{ background:var(--accent); color:var(--navy); }
/* Eingabezeile */
.mock-ai-input{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  margin:0 14px 14px; padding:9px 6px 9px 13px;
  border:1px solid var(--chat-border); border-radius:10px;
  background:var(--chat-panel);
}
.mi-placeholder{ font-family:var(--font-mono); font-size:0.68rem; color:#66707c; }
.mi-send{
  width:26px; height:26px; border-radius:8px; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  background:var(--accent); color:var(--navy);
}
.mi-send svg{ width:13px; height:13px; }

/* Section-Grundgerüst */
.topics-section{ padding:68px 24px 40px; position:relative; z-index:1; max-width:1140px; margin:0 auto; }
.topics-header{ margin-bottom:32px; }
.topics-title{ font-family:var(--font-display); font-size:clamp(1.5rem,2.6vw,1.85rem); font-weight:700; letter-spacing:-0.02em; color:var(--navy); margin-bottom:8px; }
.topics-sub{ font-size:0.9rem; color:var(--muted); max-width:52ch; }
.topics-grid{ display:grid; grid-template-columns:1fr; gap:12px; }
@media(min-width:640px){ .topics-grid{ grid-template-columns:repeat(2,1fr); } }
@media(min-width:1024px){ .topics-grid{ grid-template-columns:repeat(3,1fr); } }
.topic-card{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
  padding:24px 22px; position:relative;
  display:flex; flex-direction:column;
  transition:border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.topic-card:hover{ border-color:var(--tc); transform:translateY(-3px); box-shadow:0 14px 34px rgba(26,54,93,0.09); }
.tc-icon{
  display:flex; align-items:center; justify-content:center;
  width:44px; height:44px; margin-bottom:16px;
  color:var(--tc); border-radius:10px;
  background:color-mix(in srgb, var(--tc) 11%, transparent);
}
.tc-icon :global(svg){ width:23px; height:23px; }
.tc-title{ font-family:var(--font-display); font-size:1.08rem; font-weight:700; letter-spacing:-0.01em; color:var(--navy); margin-bottom:7px; }
.tc-desc{ font-size:0.83rem; color:var(--muted); line-height:1.6; margin-bottom:18px; flex:1; }
.tc-footer{ display:flex; justify-content:space-between; align-items:center; gap:8px; padding-top:14px; border-top:1px solid var(--border); }
.tc-link{ font-family:var(--font-display); font-size:0.82rem; color:var(--tc); font-weight:600; transition:gap 0.15s; }
.tc-link:hover{ opacity:0.8; }
.tc-count{ font-family:var(--font-mono); font-size:0.68rem; color:var(--muted2); }

/* Neueste Artikel */
.latest-section{ padding:28px 24px 56px; position:relative; z-index:1; max-width:1140px; margin:0 auto; }
.latest-header{ display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:24px; }
