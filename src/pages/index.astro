---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const topics = [
  { id:'geo', icon:'🌐', label:'GEO Grundlagen', sub:'Was ist Generative Engine Optimization und warum klassisches SEO nicht mehr reicht.', color:'#00c2ff', articles:3 },
  { id:'aeo', icon:'🎯', label:'AEO & Answer Engines', sub:'Optimierung für Featured Snippets, Voice Search und direkte KI-Antworten.', color:'#7b5ea7', articles:3 },
  { id:'llm', icon:'🤖', label:'LLM & KI-Suchmaschinen', sub:'ChatGPT Search, Perplexity und Google AI Overviews verstehen und nutzen.', color:'#00e5a0', articles:3 },
  { id:'schema', icon:'🏗️', label:'Strukturierte Daten', sub:'Schema Markup und maschinenlesbare Signale für KI-Antwortmaschinen.', color:'#ff8c42', articles:3 },
  { id:'content', icon:'✍️', label:'Content & E-E-A-T', sub:'Vertrauen, Autorität und zitierfähige Inhalte als Grundlage für GEO-Erfolg.', color:'#ff4f8b', articles:3 },
  { id:'tools', icon:'🛠️', label:'Tools & Messung', sub:'GEO-Erfolge sichtbar machen, messen und kontinuierlich verbessern.', color:'#ffd23f', articles:3 },
];

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const allPosts = Object.values(postModules) as any[];
const latestPosts = allPosts
  .sort((a,b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
  .slice(0, 3);
---
<Base title="Sichtbar in der KI-Ära — SimplyGEO" description="GEO, AEO und KI-Suche einfach erklärt. Praxisnahes Wissen für den DACH-Markt von Yassine Oulada.">
  <Header />
  <section class="hero">
    <div class="hero-left">
      <div class="hero-audience">
        <span class="audience-tag">SEO & Marketing</span>
        <span class="audience-tag">B2B Unternehmen</span>
        <span class="audience-tag">DACH-Markt</span>
      </div>
      <h1 class="hero-title">Wirst du von ChatGPT &amp; Perplexity <em>zitiert</em> — oder übergangen?</h1>
      <p class="hero-desc">KI-Suchsysteme entscheiden, welche Websites in ihren Antworten erscheinen. Hier lernst du, wie GEO funktioniert — und wie du einer der zitierten Quellen im DACH-Markt wirst.</p>
      <ul class="hero-values">
        <li><span class="hv-check">✓</span> 8 Praxis-Artikel speziell für den deutschsprachigen Markt</li>
        <li><span class="hv-check">✓</span> Umsetzbare Strategien — kein Buzzword-Bingo</li>
        <li><span class="hv-check">✓</span> Von einem Practitioner, der GEO täglich anwendet</li>
      </ul>
      <div class="hero-cta">
        <a href="#topics" class="btn-primary">Jetzt GEO lernen →</a>
        <a href="/downloads/geo-checkliste-2025.pdf" class="btn-secondary" download>⬇ Checkliste laden</a>
      </div>
    </div>
    <div class="hero-right">
      <!-- Mock AI Citation Visual -->
      <div class="mock-ai">
        <div class="mock-ai-header">
          <div class="mock-ai-dot"></div>
          <span class="mock-ai-label">KI-Antwort — Perplexity AI</span>
        </div>
        <div class="mock-ai-query">"Was ist Generative Engine Optimization?"</div>
        <div class="mock-ai-answer">
          <p>Generative Engine Optimization (GEO) ist die Praxis, Inhalte so zu optimieren, dass sie von KI-Suchsystemen als vertrauenswürdige Quellen zitiert werden. Im Unterschied zu klassischem SEO geht es nicht um Rankings, sondern um <strong>Zitierbarkeit in KI-Antworten</strong>.</p>
        </div>
        <div class="mock-ai-sources">
          <div class="mock-ai-sources-label">Quellen</div>
          <div class="mock-sources-list">
            <div class="mock-source active">
              <div class="ms-num">1</div>
              <div class="ms-info">
                <div class="ms-domain">simplygeo.de</div>
                <div class="ms-title">Was ist GEO? Generative Engine Optimization einfach erklärt</div>
              </div>
            </div>
            <div class="mock-source">
              <div class="ms-num">2</div>
              <div class="ms-info">
                <div class="ms-domain">example-blog.de</div>
                <div class="ms-title">GEO für Anfänger</div>
              </div>
            </div>
            <div class="mock-source">
              <div class="ms-num">3</div>
              <div class="ms-info">
                <div class="ms-domain">marketingsite.de</div>
                <div class="ms-title">Suchmaschinenoptimierung 2025</div>
              </div>
            </div>
          </div>
        </div>
        <div class="mock-ai-cta">Das ist GEO. <a href="/themen/geo">So erreichst du das →</a></div>
      </div>
    </div>
  </section>

  <section class="topics-section" id="topics">
    <div class="topics-header">
      <h2 class="topics-title">Alle Themenbereiche</h2>
      <p class="topics-sub">Wähle einen Bereich und arbeite dich Schritt für Schritt durch.</p>
    </div>
    <div class="topics-grid">
      {topics.map(t => (
        <article class="topic-card" id={t.id} style={`--tc:${t.color}`}>
          <span class="tc-icon">{t.icon}</span>
          <h3 class="tc-title">{t.label}</h3>
          <p class="tc-desc">{t.sub}</p>
          <a href={`/themen/${t.id}`} class="tc-link">Artikel ansehen →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- Neueste Artikel -->
  <section class="latest-section">
    <div class="latest-header">
      <h2 class="latest-title">Neueste Artikel</h2>
      <a href="/blog" class="latest-all">Alle Artikel →</a>
    </div>
    <div class="latest-grid">
      {latestPosts.map((post: any) => (
        <a href={`/blog/${post.frontmatter.slug}`} class="latest-card">
          {post.frontmatter.heroImage && (
            <div class="lc-thumb">
              <img src={post.frontmatter.heroImage} alt={post.frontmatter.title} loading="lazy" />
            </div>
          )}
          <div class="lc-body">
            <div class="lc-meta">
              {post.frontmatter.category && (
                <span class="lc-cat" style={`color:${post.frontmatter.categoryColor||'var(--accent)'}`}>
                  {post.frontmatter.category}
                </span>
              )}
              {post.frontmatter.level && <span class="lc-level">{post.frontmatter.level}</span>}
            </div>
            <h3 class="lc-title">{post.frontmatter.title}</h3>
            <p class="lc-desc">{post.frontmatter.description}</p>
            <div class="lc-footer">
              <div class="lc-author">
                <div class="lc-avatar">YA</div>
                <span>Yassine Oulada</span>
              </div>
              <span class="lc-date">
                {new Intl.DateTimeFormat('de-DE',{year:'numeric',month:'long',day:'numeric'}).format(new Date(post.frontmatter.pubDate))}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="latest-more">
      <a href="/blog" class="btn-secondary">Alle Artikel ansehen →</a>
    </div>
  </section>

  <section class="dl-section">
    <div class="dl-inner">
      <div class="dl-icon">📋</div>
      <div class="dl-body">
        <h2 class="dl-title">GEO-Checkliste 2025 — kostenlos</h2>
        <p class="dl-desc">36 Checkpunkte in 6 Bereichen. Direkt anwendbar für deine Website.</p>
      </div>
      <a href="/downloads/geo-checkliste-2025.pdf" class="btn-primary" download>⬇ Jetzt herunterladen</a>
    </div>
  </section>
  <Footer />
</Base>
<style>
.hero { border-bottom:1px solid var(--border); position:relative; overflow:hidden; padding:40px 24px 40px; }
@media(min-width:768px){ .hero{ display:grid; grid-template-columns:1fr 1fr; min-height:420px; padding:0; } }
.hero-left { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; }
@media(min-width:768px){ .hero-left{ padding:52px 44px; border-right:1px solid var(--border); } }

/* Audience tags */
.hero-audience{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
.audience-tag{
  font-size:0.62rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase;
  color:var(--accent); background:rgba(0,194,255,0.1);
  border:1px solid rgba(0,194,255,0.25); padding:3px 10px; border-radius:20px;
}

/* Headline */
.hero-title{ font-family:'Space Grotesk',sans-serif; font-size:clamp(1.6rem,3.2vw,2.2rem); font-weight:700; letter-spacing:-0.03em; line-height:1.18; color:var(--text); margin-bottom:14px; }
.hero-title em{ font-style:normal; background:linear-gradient(135deg,var(--accent),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

/* Description */
.hero-desc{ font-size:0.88rem; color:var(--muted); line-height:1.7; max-width:480px; margin-bottom:18px; }

/* Value list */
.hero-values{ list-style:none; margin-bottom:24px; display:flex; flex-direction:column; gap:7px; }
.hero-values li{ font-size:0.82rem; color:var(--muted); display:flex; align-items:flex-start; gap:8px; line-height:1.45; }
.hv-check{ color:var(--accent); font-weight:700; flex-shrink:0; }

.hero-cta{ display:flex; gap:10px; flex-wrap:wrap; }

/* Right side — Mock AI Visual */
.hero-right{ display:none; }
@media(min-width:768px){ .hero-right{ display:flex; align-items:center; justify-content:center; padding:40px 36px; background:var(--surface); } }

.mock-ai{
  width:100%; max-width:420px;
  background:var(--bg); border:1px solid var(--border);
  border-radius:var(--radius); overflow:hidden;
  font-size:0.78rem;
}
.mock-ai-header{
  display:flex; align-items:center; gap:8px;
  padding:10px 14px; border-bottom:1px solid var(--border);
  background:var(--surface);
}
.mock-ai-dot{ width:8px; height:8px; border-radius:50%; background:#00e5a0; flex-shrink:0; box-shadow:0 0 6px rgba(0,229,160,0.5); }
.mock-ai-label{ font-size:0.68rem; font-weight:600; color:var(--muted); letter-spacing:0.04em; }
.mock-ai-query{
  padding:12px 14px 10px;
  font-size:0.8rem; font-weight:600; color:var(--text);
  border-bottom:1px solid var(--border);
  background:rgba(0,194,255,0.04);
}
.mock-ai-answer{
  padding:14px;
  border-bottom:1px solid var(--border);
}
.mock-ai-answer p{ font-size:0.78rem; color:var(--muted); line-height:1.65; margin:0; }
.mock-ai-answer strong{ color:var(--text); }
.mock-ai-sources{ padding:12px 14px; border-bottom:1px solid var(--border); }
.mock-ai-sources-label{ font-size:0.6rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted2); margin-bottom:8px; }
.mock-sources-list{ display:flex; flex-direction:column; gap:6px; }
.mock-source{
  display:flex; align-items:flex-start; gap:8px;
  padding:7px 9px; border-radius:var(--radius-sm);
  border:1px solid transparent;
  transition:background 0.15s;
}
.mock-source.active{
  background:rgba(0,194,255,0.07);
  border-color:rgba(0,194,255,0.2);
}
.ms-num{
  width:18px; height:18px; border-radius:4px; flex-shrink:0;
  background:var(--border); display:flex; align-items:center; justify-content:center;
  font-size:0.62rem; font-weight:700; color:var(--muted);
}
.mock-source.active .ms-num{ background:rgba(0,194,255,0.2); color:var(--accent); }
.ms-domain{ font-size:0.68rem; font-weight:700; color:var(--muted2); }
.mock-source.active .ms-domain{ color:var(--accent); }
.ms-title{ font-size:0.68rem; color:var(--muted); line-height:1.3; }
.mock-ai-cta{
  padding:10px 14px;
  font-size:0.72rem; color:var(--muted);
  background:var(--surface);
}
.mock-ai-cta a{ color:var(--accent); font-weight:600; }
.btn-primary{ display:inline-flex; align-items:center; gap:6px; font-family:'Space Grotesk',sans-serif; font-size:0.85rem; font-weight:600; padding:10px 20px; background:var(--accent); color:var(--bg); border-radius:var(--radius-sm); transition:opacity 0.2s,transform 0.15s; }
.btn-primary:hover{ opacity:0.88; transform:translateY(-1px); }
.btn-secondary{ display:inline-flex; align-items:center; gap:6px; font-size:0.82rem; color:var(--muted); padding:10px 16px; border:1px solid var(--border2); border-radius:var(--radius-sm); transition:color 0.15s,border-color 0.15s; }
.btn-secondary:hover{ color:var(--text); border-color:var(--muted2); }
.topics-section{ padding:48px 24px; position:relative; z-index:1; }
.topics-header{ margin-bottom:28px; }
.topics-title{ font-family:'Space Grotesk',sans-serif; font-size:1.4rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.topics-sub{ font-size:0.85rem; color:var(--muted); }
.topics-grid{ display:grid; grid-template-columns:1fr; gap:10px; }
@media(min-width:640px){ .topics-grid{ grid-template-columns:repeat(2,1fr); } }
@media(min-width:1024px){ .topics-grid{ grid-template-columns:repeat(3,1fr); } }
.topic-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:20px; position:relative; overflow:hidden; transition:border-color 0.2s,background 0.2s; }
.topic-card::before{ content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--tc); }
.topic-card:hover{ border-color:var(--border2); background:var(--surface2); }
.tc-icon{ font-size:1.4rem; margin-bottom:10px; display:block; }
.tc-title{ font-family:'Space Grotesk',sans-serif; font-size:0.95rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.tc-desc{ font-size:0.78rem; color:var(--muted); line-height:1.55; margin-bottom:14px; }
.tc-link{ font-size:0.75rem; color:var(--tc); font-weight:600; transition:opacity 0.15s; }
.tc-link:hover{ opacity:0.75; }

/* Neueste Artikel */
.latest-section{ padding:0 24px 48px; position:relative; z-index:1; max-width:1100px; margin:0 auto; }
.latest-header{ display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
.latest-title{ font-family:'Space Grotesk',sans-serif; font-size:1.4rem; font-weight:700; color:var(--text); }
.latest-all{ font-size:0.8rem; color:var(--accent); font-weight:600; transition:opacity 0.15s; }
.latest-all:hover{ opacity:0.75; }
.latest-grid{ display:grid; gap:10px; }
@media(min-width:640px){ .latest-grid{ grid-template-columns:repeat(2,1fr); } }
@media(min-width:1024px){ .latest-grid{ grid-template-columns:repeat(3,1fr); } }
.latest-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; text-decoration:none; transition:border-color 0.15s,transform 0.15s; display:flex; flex-direction:column; }
.latest-card:hover{ border-color:var(--border2); transform:translateY(-2px); }
.lc-thumb{ aspect-ratio:16/9; overflow:hidden; }
.lc-thumb img{ width:100%; height:100%; object-fit:cover; }
.lc-body{ padding:16px; flex:1; display:flex; flex-direction:column; }
.lc-meta{ display:flex; gap:6px; margin-bottom:8px; align-items:center; }
.lc-cat{ font-size:0.62rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; }
.lc-level{ font-size:0.62rem; color:var(--muted); background:var(--border); padding:2px 7px; border-radius:20px; }
.lc-title{ font-family:'Space Grotesk',sans-serif; font-size:0.92rem; font-weight:700; color:var(--text); margin-bottom:6px; line-height:1.3; }
.lc-desc{ font-size:0.77rem; color:var(--muted); line-height:1.5; margin-bottom:12px; flex:1; }
.lc-footer{ display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; }
.lc-author{ display:flex; align-items:center; gap:6px; }
.lc-avatar{ width:22px; height:22px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--purple)); display:flex; align-items:center; justify-content:center; font-family:'Space Grotesk',sans-serif; font-size:0.55rem; font-weight:700; color:#070d1a; flex-shrink:0; }
.lc-author span{ font-size:0.7rem; color:var(--muted); font-weight:500; }
.lc-date{ font-size:0.67rem; color:var(--muted2); }
.latest-more{ margin-top:20px; display:flex; justify-content:center; }

.dl-section{ padding:0 24px 48px; position:relative; z-index:1; }
.dl-inner{ background:linear-gradient(135deg,rgba(0,194,255,0.07),rgba(123,94,167,0.07)); border:1px solid rgba(0,194,255,0.2); border-radius:var(--radius); padding:24px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.dl-icon{ font-size:2rem; flex-shrink:0; }
.dl-body{ flex:1; min-width:200px; }
.dl-title{ font-family:'Space Grotesk',sans-serif; font-size:1rem; font-weight:700; color:var(--text); margin-bottom:4px; }
.dl-desc{ font-size:0.8rem; color:var(--muted); }
</style>
