---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const icons: Record<string, string> = {
  geo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>`,
  aeo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>`,
  llm: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9 7V4M15 7V4M9 20v-3M15 20v-3M7 9H4M7 15H4M20 9h-3M20 15h-3"/></svg>`,
  schema: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4C6 4 6 6 6 7.5S6 11 4 12c2 1 2 3 2 4.5S6 20 8 20"/><path d="M16 4c2 0 2 2 2 3.5S18 11 20 12c-2 1-2 3-2 4.5s0 3.5-2 3.5"/></svg>`,
  content: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l3.5-1 11-11a2.1 2.1 0 0 0-3-3l-11 11L4 20z"/><path d="M13 6l3 3"/></svg>`,
  tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5 19a9 9 0 1 1 14 0"/><path d="M12 13l4-4"/><circle cx="12" cy="14" r="1.4" fill="currentColor" stroke="none"/></svg>`,
};

const topics = [
  { id:'geo', label:'GEO Grundlagen', cat:'GEO Grundlagen', sub:'Was ist Generative Engine Optimization und warum klassisches SEO nicht mehr reicht.', color:'#e2552a' },
  { id:'aeo', label:'AEO & Answer Engines', cat:'AEO & Answer Engines', sub:'Optimierung für Featured Snippets, Voice Search und direkte KI-Antworten.', color:'#1e3d59' },
  { id:'llm', label:'LLM & KI-Suchmaschinen', cat:'LLM & KI-Suchmaschinen', sub:'ChatGPT Search, Perplexity und Google AI Overviews verstehen und nutzen.', color:'#2e6e8f' },
  { id:'schema', label:'Strukturierte Daten', cat:'Strukturierte Daten', sub:'Schema Markup und maschinenlesbare Signale für KI-Antwortmaschinen.', color:'#b9871c' },
  { id:'content', label:'Content & E-E-A-T', cat:'Content & E-E-A-T', sub:'Vertrauen, Autorität und zitierfähige Inhalte als Grundlage für GEO-Erfolg.', color:'#a63d2f' },
  { id:'tools', label:'Tools & Messung', cat:'Tools & Messung', sub:'GEO-Erfolge sichtbar machen, messen und kontinuierlich verbessern.', color:'#5c7186' },
];

const postModules = import.meta.glob('../content/blog/*.md', { eager: true });
const allPosts = Object.values(postModules) as any[];
const countFor = (cat: string) => allPosts.filter((p: any) => p.frontmatter.category === cat).length;
const latestPosts = allPosts
  .sort((a,b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
  .slice(0, 3);

const faqs = [
  {
    q: 'Was ist Generative Engine Optimization (GEO)?',
    a: 'GEO ist die Praxis, Websites und Inhalte so zu optimieren, dass sie von KI-gestützten Suchsystemen wie ChatGPT Search, Perplexity und Google AI Overviews als vertrauenswürdige Quelle erkannt und zitiert werden.',
  },
  {
    q: 'Brauche ich GEO zusätzlich zu SEO?',
    a: 'Ja: GEO ersetzt SEO nicht, sondern erweitert es. SEO bleibt das Fundament für organische Sichtbarkeit; GEO sorgt dafür, dass du auch in den generierten Antworten der KI-Systeme vorkommst, wo immer mehr Suchanfragen enden.',
  },
  {
    q: 'Welche KI-Suchsysteme sind im DACH-Markt relevant?',
    a: 'Die drei wichtigsten sind Google AI Overviews (wegen Googles Marktdominanz), ChatGPT Search (wegen der hohen Nutzung in der DACH-Region) und Perplexity AI (schnell wachsend, zitiert Quellen besonders sichtbar).',
  },
  {
    q: 'Wie lange dauert es, bis GEO Ergebnisse zeigt?',
    a: 'Aus der Praxis: Erste messbare Erwähnungen in KI-Antworten sind nach etwa 90 Tagen realistisch, vorausgesetzt, die technische Basis stimmt und der Content wird konsequent nach GEO-Prinzipien aufgebaut.',
  },
  {
    q: 'Wo fange ich mit GEO am besten an?',
    a: 'Mit drei Maßnahmen: robots.txt für alle KI-Bots öffnen, Autorenprofile mit Schema Markup anlegen und bestehende Artikel so umschreiben, dass die wichtigste Antwort in den ersten Sätzen steht.',
  },
];
---
<Base title="Sichtbar in der KI-Ära" description="GEO, AEO und KI-Suche einfach erklärt. Praxisnahes Wissen für den DACH-Markt von Yassine Oulada.">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "SimplyGEO",
      "url": "https://simplygeo.de",
      "logo": "https://simplygeo.de/images/og-default.png",
      "description": "Wissensplattform für Generative Engine Optimization (GEO), AEO und KI-Suche im DACH-Markt.",
      "founder": {
        "@type": "Person",
        "name": "Yassine Oulada",
        "jobTitle": "GEO & SEO Spezialist",
        "url": "https://simplygeo.de/about",
        "sameAs": ["https://www.linkedin.com/in/yassine-o-726988196/"]
      }
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  </Fragment>

  <Header />
  <main id="main">
  <section class="hero">
    <div class="hero-left">
      <div class="hero-audience">
        <span class="audience-tag">SEO & Marketing</span>
        <span class="audience-tag">B2B Unternehmen</span>
        <span class="audience-tag">DACH-Markt</span>
      </div>
      <h1 class="hero-title">Wirst du von ChatGPT &amp; Perplexity <em>zitiert</em> — oder übergangen?</h1>
      <p class="hero-desc">KI-Suchsysteme entscheiden, welche Websites in ihren Antworten erscheinen. Hier lernst du, wie GEO funktioniert und wie du einer der zitierten Quellen im DACH-Markt wirst.</p>
      <ul class="hero-values">
        <li><span class="hv-check">✓</span> {allPosts.length} Praxis-Artikel speziell für den deutschsprachigen Markt</li>
        <li><span class="hv-check">✓</span> Umsetzbare Strategien, kein Buzzword-Bingo</li>
        <li><span class="hv-check">✓</span> Von einem Practitioner, der GEO täglich anwendet</li>
      </ul>
      <div class="hero-cta">
        <a href="#topics" class="btn-primary">Jetzt GEO lernen →</a>
        <a href="/downloads/geo-checkliste.pdf" class="btn-secondary" download>⬇ Checkliste laden</a>
      </div>
    </div>
    <div class="hero-right">
      <!-- Mock AI Citation Visual -->
      <div class="mock-ai">
        <div class="mock-ai-header">
          <div class="mock-ai-dot"></div>
          <span class="mock-ai-label">KI-Antwort · Perplexity AI</span>
        </div>
        <div class="mock-ai-query">"Was ist Generative Engine Optimization?"</div>
        <div class="mock-ai-answer">
          <p>Generative Engine Optimization (GEO) ist die Praxis, Inhalte so zu optimieren, dass sie von KI-Suchsystemen als vertrauenswürdige Quellen zitiert werden. Im Unterschied zu klassischem SEO geht es nicht um Rankings, sondern um <strong>Zitierbarkeit in KI-Antworten</strong>.</p>
        </div>
        <div class="mock-ai-sources">
          <div class="mock-ai-sources-label">Quellen</div>
          <div class="mock-sources-list">
            <div class="mock-source active">
              <div class="ms-num">1</div>
              <div class="ms-info">
                <div class="ms-domain">simplygeo.de</div>
                <div class="ms-title">Was ist GEO? Generative Engine Optimization einfach erklärt</div>
              </div>
            </div>
            <div class="mock-source">
              <div class="ms-num">2</div>
              <div class="ms-info">
                <div class="ms-domain">example-blog.de</div>
                <div class="ms-title">GEO für Anfänger</div>
              </div>
            </div>
            <div class="mock-source">
              <div class="ms-num">3</div>
              <div class="ms-info">
                <div class="ms-domain">marketingsite.de</div>
                <div class="ms-title">Suchmaschinenoptimierung 2026</div>
              </div>
            </div>
          </div>
        </div>
        <div class="mock-ai-cta">Das ist GEO. <a href="/themen/geo">So erreichst du das →</a></div>
      </div>
    </div>
  </section>

  <!-- Starte hier -->
  <div class="start-strip">
    <span class="ss-label">Neu hier?</span>
    <a href="/blog/was-ist-geo" class="ss-link">Starte mit „Was ist GEO?" , dem 8-Minuten-Einstieg →</a>
  </div>

  <section class="topics-section" id="topics">
    <div class="topics-header">
      <span class="eyebrow">Wissensbereiche</span>
      <h2 class="topics-title">Alle Themenbereiche</h2>
      <p class="topics-sub">Wähle einen Bereich und arbeite dich Schritt für Schritt durch.</p>
    </div>
    <div class="topics-grid">
      {topics.map(t => (
        <article class="topic-card" id={t.id} style={`--tc:${t.color}`}>
          <span class="tc-icon" set:html={icons[t.id]} />
          <h3 class="tc-title">{t.label}</h3>
          <p class="tc-desc">{t.sub}</p>
          <div class="tc-footer">
            <a href={`/themen/${t.id}`} class="tc-link">Zum Themenbereich →</a>
            <span class="tc-count">{countFor(t.cat)} {countFor(t.cat) === 1 ? 'Artikel' : 'Artikel'}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Neueste Artikel -->
  <section class="latest-section">
    <div class="latest-header">
      <div>
        <span class="eyebrow">Blog</span>
        <h2 class="latest-title">Neueste Artikel</h2>
      </div>
      <a href="/blog" class="latest-all">Alle Artikel →</a>
    </div>
    <div class="latest-grid">
      {latestPosts.map((post: any) => (
        <a href={`/blog/${post.frontmatter.slug}`} class="latest-card">
          {post.frontmatter.heroImage && (
            <div class="lc-thumb">
              <img src={post.frontmatter.heroImage} alt={post.frontmatter.title} loading="lazy" />
            </div>
          )}
          <div class="lc-body">
            <div class="lc-meta">
              {post.frontmatter.category && (
                <span class="lc-cat" style={`color:${post.frontmatter.categoryColor||'var(--accent)'}`}>
                  {post.frontmatter.category}
                </span>
              )}
              {post.frontmatter.level && <span class="lc-level">{post.frontmatter.level}</span>}
            </div>
            <h3 class="lc-title">{post.frontmatter.title}</h3>
            <p class="lc-desc">{post.frontmatter.description}</p>
            <div class="lc-footer">
              <div class="lc-author">
                <div class="lc-avatar">YA</div>
                <span>Yassine Oulada</span>
              </div>
              <span class="lc-date">
                {new Intl.DateTimeFormat('de-DE',{year:'numeric',month:'long',day:'numeric'}).format(new Date(post.frontmatter.pubDate))}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="latest-more">
      <a href="/blog" class="btn-secondary">Alle Artikel ansehen →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <span class="eyebrow">FAQ</span>
    <h2 class="faq-title">Häufige Fragen zu GEO</h2>
    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-q">{f.q}</summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="dl-section">
    <div class="dl-inner">
      <div class="dl-icon">📋</div>
      <div class="dl-body">
        <h2 class="dl-title">Die kostenlose GEO-Checkliste</h2>
        <p class="dl-desc">36 Checkpunkte in 6 Bereichen. Direkt anwendbar für deine Website.</p>
      </div>
      <a href="/downloads/geo-checkliste.pdf" class="btn-primary" download>⬇ Jetzt herunterladen</a>
    </div>
  </section>
  </main>
  <Footer />
</Base>
<style>
.hero { background:var(--navy); position:relative; overflow:hidden; padding:40px 24px 40px; }
@media(min-width:768px){ .hero{ display:grid; grid-template-columns:1fr 1fr; min-height:420px; padding:0; } }
.hero-left { position:relative; z-index:1; display:flex; flex-direction:column; justify-content:center; }
@media(min-width:768px){ .hero-left{ padding:52px 44px; } }

/* Audience tags */
.hero-audience{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
.audience-tag{
  font-size:0.62rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase;
  color:var(--mango); background:rgba(255,193,59,0.12);
  border:1px solid rgba(255,193,59,0.35); padding:3px 10px; border-radius:20px;
}

/* Headline */
.hero-title{ font-family:'Space Grotesk',sans-serif; font-size:clamp(1.6rem,3.2vw,2.2rem); font-weight:700; letter-spacing:-0.03em; line-height:1.18; color:var(--on-navy-text); margin-bottom:14px; }
.hero-title em{ font-style:normal; background:linear-gradient(135deg,var(--accent),var(--mango)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

/* Description */
.hero-desc{ font-size:0.88rem; color:var(--on-navy-muted); line-height:1.7; max-width:480px; margin-bottom:18px; }

/* Value list */
.hero-values{ list-style:none; margin-bottom:24px; display:flex; flex-direction:column; gap:7px; }
.hero-values li{ font-size:0.82rem; color:var(--on-navy-muted); display:flex; align-items:flex-start; gap:8px; line-height:1.45; }
.hv-check{ color:var(--mango); font-weight:700; flex-shrink:0; }

.hero-cta{ display:flex; gap:10px; flex-wrap:wrap; }
/* Sekundär-Button auf Navy: helle Variante */
.hero .btn-secondary{ color:var(--on-navy-text); border-color:var(--on-navy-muted); }
.hero .btn-secondary:hover{ background:var(--almond); color:var(--navy); border-color:var(--almond); }

/* Right side — Mock AI Visual (helle Paper-Karte auf Navy) */
.hero-right{ display:none; }
@media(min-width:768px){ .hero-right{ display:flex; align-items:center; justify-content:center; padding:40px 36px; background:var(--navy-deep); } }

.mock-ai{
  width:100%; max-width:420px;
  background:var(--paper); border:1px solid var(--border2);
  border-radius:var(--radius); overflow:hidden;
  font-size:0.78rem;
  box-shadow:0 12px 40px rgba(0,0,0,0.25);
}
.mock-ai-header{
  display:flex; align-items:center; gap:8px;
  padding:10px 14px; border-bottom:1px solid var(--border);
  background:var(--surface);
}
.mock-ai-dot{ width:8px; height:8px; border-radius:50%; background:var(--mango); flex-shrink:0; box-shadow:0 0 6px rgba(255,193,59,0.6); }
.mock-ai-label{ font-size:0.68rem; font-weight:600; color:var(--muted); letter-spacing:0.04em; }
.mock-ai-query{
  padding:12px 14px 10px;
  font-size:0.8rem; font-weight:600; color:var(--text);
  border-bottom:1px solid var(--border);
  background:rgba(226,85,42,0.04);
}
.mock-ai-answer{
  padding:14px;
  border-bottom:1px solid var(--border);
}
.mock-ai-answer p{ font-size:0.78rem; color:var(--muted); line-height:1.65; margin:0; }
.mock-ai-answer strong{ color:var(--text); }
.mock-ai-sources{ padding:12px 14px; border-bottom:1px solid var(--border); }
.mock-ai-sources-label{ font-size:0.6rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted2); margin-bottom:8px; }
.mock-sources-list{ display:flex; flex-direction:column; gap:6px; }
.mock-source{
  display:flex; align-items:flex-start; gap:8px;
  padding:7px 9px; border-radius:var(--radius-sm);
  border:1px solid transparent;
  transition:background 0.15s;
}
.mock-source.active{
  background:rgba(226,85,42,0.07);
  border-color:rgba(226,85,42,0.2);
}
.ms-num{
  width:18px; height:18px; border-radius:4px; flex-shrink:0;
  background:var(--border); display:flex; align-items:center; justify-content:center;
  font-size:0.62rem; font-weight:700; color:var(--muted);
}
.mock-source.active .ms-num{ background:rgba(226,85,42,0.2); color:var(--accent); }
.ms-domain{ font-size:0.68rem; font-weight:700; color:var(--muted2); }
.mock-source.active .ms-domain{ color:var(--accent); }
.ms-title{ font-size:0.68rem; color:var(--muted); line-height:1.3; }
.mock-ai-cta{
  padding:10px 14px;
  font-size:0.72rem; color:var(--muted);
  background:var(--surface);
}
.mock-ai-cta a{ color:var(--accent); font-weight:600; }

/* Start strip */
.start-strip{
  display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap;
  padding:12px 24px;
  border-bottom:1px solid var(--border);
  background:rgba(226,85,42,0.03);
  position:relative; z-index:1;
}
.ss-label{
  font-size:0.68rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;
  color:var(--accent);
}
.ss-link{ font-size:0.82rem; color:var(--text); font-weight:500; transition:color 0.15s; }
.ss-link:hover{ color:var(--accent); }

.topics-section{ padding:56px 24px; position:relative; z-index:1; max-width:1100px; margin:0 auto; }
.topics-header{ margin-bottom:28px; }
.topics-title{ font-family:'Space Grotesk',sans-serif; font-size:1.4rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.topics-sub{ font-size:0.85rem; color:var(--muted); }
.topics-grid{ display:grid; grid-template-columns:1fr; gap:10px; }
@media(min-width:640px){ .topics-grid{ grid-template-columns:repeat(2,1fr); } }
@media(min-width:1024px){ .topics-grid{ grid-template-columns:repeat(3,1fr); } }
.topic-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:20px; position:relative; overflow:hidden; transition:border-color 0.2s,background 0.2s; }
.topic-card::before{ content:''; position:absolute; top:0; left:0; right:0; height:3px; background:var(--tc); }
.topic-card:hover{ border-color:var(--border2); background:var(--surface2); }
.tc-icon{
  display:flex; align-items:center; justify-content:center;
  width:42px; height:42px; margin-bottom:14px;
  color:var(--tc); border-radius:10px;
  background:color-mix(in srgb, var(--tc) 10%, transparent);
  border:1px solid color-mix(in srgb, var(--tc) 22%, transparent);
}
.tc-icon :global(svg){ width:22px; height:22px; }
.tc-title{ font-family:'Space Grotesk',sans-serif; font-size:0.95rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.tc-desc{ font-size:0.78rem; color:var(--muted); line-height:1.55; margin-bottom:14px; }
.tc-footer{ display:flex; justify-content:space-between; align-items:center; gap:8px; }
.tc-link{ font-size:0.75rem; color:var(--tc); font-weight:600; transition:opacity 0.15s; }
.tc-link:hover{ opacity:0.75; }
.tc-count{ font-size:0.68rem; color:var(--muted2); }

/* Neueste Artikel */
.latest-section{ padding:0 24px 48px; position:relative; z-index:1; max-width:1100px; margin:0 auto; }
.latest-header{ display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
.latest-title{ font-family:'Space Grotesk',sans-serif; font-size:1.4rem; font-weight:700; color:var(--text); }
.latest-all{ font-size:0.8rem; color:var(--accent); font-weight:600; transition:opacity 0.15s; }
.latest-all:hover{ opacity:0.75; }
.latest-grid{ display:grid; gap:10px; }
@media(min-width:640px){ .latest-grid{ grid-template-columns:repeat(2,1fr); } }
@media(min-width:1024px){ .latest-grid{ grid-template-columns:repeat(3,1fr); } }
.latest-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; text-decoration:none; transition:border-color 0.15s,transform 0.15s; display:flex; flex-direction:column; }
.latest-card:hover{ border-color:var(--border2); transform:translateY(-2px); }
.lc-thumb{ aspect-ratio:16/9; overflow:hidden; }
.lc-thumb img{ width:100%; height:100%; object-fit:cover; }
.lc-body{ padding:16px; flex:1; display:flex; flex-direction:column; }
.lc-meta{ display:flex; gap:6px; margin-bottom:8px; align-items:center; }
.lc-cat{ font-size:0.62rem; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; }
.lc-level{ font-size:0.62rem; color:var(--muted); background:var(--border); padding:2px 7px; border-radius:20px; }
.lc-title{ font-family:'Space Grotesk',sans-serif; font-size:0.92rem; font-weight:700; color:var(--text); margin-bottom:6px; line-height:1.3; }
.lc-desc{ font-size:0.77rem; color:var(--muted); line-height:1.5; margin-bottom:12px; flex:1; }
.lc-footer{ display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; }
.lc-author{ display:flex; align-items:center; gap:6px; }
.lc-avatar{ width:22px; height:22px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--purple)); display:flex; align-items:center; justify-content:center; font-family:'Space Grotesk',sans-serif; font-size:0.55rem; font-weight:700; color:#1e3d59; flex-shrink:0; }
.lc-author span{ font-size:0.7rem; color:var(--muted); font-weight:500; }
.lc-date{ font-size:0.67rem; color:var(--muted2); }
.latest-more{ margin-top:20px; display:flex; justify-content:center; }

/* FAQ */
.faq-section{ padding:0 24px 48px; position:relative; z-index:1; max-width:800px; margin:0 auto; }
.faq-title{ font-family:'Space Grotesk',sans-serif; font-size:1.4rem; font-weight:700; color:var(--text); margin-bottom:18px; }
.faq-list{ display:flex; flex-direction:column; gap:8px; }
.faq-item{
  background:var(--surface); border:1px solid var(--border);
  border-radius:var(--radius-sm); overflow:hidden;
}
.faq-item[open]{ border-color:var(--border2); }
.faq-q{
  padding:14px 16px; cursor:pointer;
  font-size:0.88rem; font-weight:600; color:var(--text);
  list-style:none; position:relative;
  transition:background 0.15s;
}
.faq-q::-webkit-details-marker{ display:none; }
.faq-q::after{
  content:'+'; position:absolute; right:16px; top:50%; transform:translateY(-50%);
  color:var(--accent); font-size:1.1rem; font-weight:400;
}
.faq-item[open] .faq-q::after{ content:'−'; }
.faq-q:hover{ background:var(--surface2); }
.faq-a{
  padding:0 16px 14px;
  font-size:0.83rem; color:var(--muted); line-height:1.65;
}

.dl-section{ padding:0 24px 48px; position:relative; z-index:1; }
.dl-inner{ background:linear-gradient(135deg,rgba(226,85,42,0.07),rgba(255,193,59,0.07)); border:1px solid rgba(226,85,42,0.2); border-radius:var(--radius); padding:24px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.dl-icon{ font-size:2rem; flex-shrink:0; }
.dl-body{ flex:1; min-width:200px; }
.dl-title{ font-family:'Space Grotesk',sans-serif; font-size:1rem; font-weight:700; color:var(--text); margin-bottom:4px; }
.dl-desc{ font-size:0.8rem; color:var(--muted); }
</style>
