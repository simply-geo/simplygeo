---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const authorPhotoPath = '/images/yassine-oulada.jpg';
const hasAuthorPhoto = fs.existsSync(path.join(process.cwd(), 'public', authorPhotoPath));

const stats = [
  { value: '724%', label: 'Impressions-Wachstum', desc: 'in 6 Monaten für einen B2B-Kunden' },
  { value: '342%', label: 'Klick-Steigerung', desc: 'durch GEO-optimierten Content' },
  { value: '15–180%', label: 'Sichtbarkeit', desc: 'Reichweiten-Zuwachs in KI-Antworten' },
];

const skills = ['GEO', 'AEO', 'SEO', 'SEA', 'MODX', 'WordPress', 'GA4', 'GSC', 'Matomo', 'Schema Markup', 'Content-Strategie'];
---
<Base title="Über Yassine Oulada — SimplyGEO" description="Yassine Oulada ist Performance Marketing Manager und GEO-Spezialist im DACH-Markt. Hier erfährst du mehr über SimplyGEO.">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Yassine Oulada",
    "jobTitle": "GEO & SEO Spezialist · Performance Marketing Manager",
    "description": "Performance Marketing Manager und Freelancer mit mehrjähriger Erfahrung im Performance Marketing und Agenturerfahrung, spezialisiert auf Generative Engine Optimization (GEO), SEO und Website-Relaunches. Betreut B2B-Unternehmen und internationale Websites.",
    "url": "https://simplygeo.de/about",
    "image": hasAuthorPhoto ? `https://simplygeo.de${authorPhotoPath}` : undefined,
    "knowsAbout": ["Generative Engine Optimization", "Answer Engine Optimization", "SEO", "SEA", "Schema Markup", "Content-Strategie"],
    "sameAs": ["https://www.linkedin.com/in/yassine-o-726988196/"],
    "mainEntityOfPage": "https://simplygeo.de/about"
  })} />
  <Header />
  <main id="main" class="about-main">
    <div class="about-inner">

      <span class="eyebrow">Über SimplyGEO</span>

      <div class="about-hero">
        {hasAuthorPhoto
          ? <img src={authorPhotoPath} alt="Yassine Oulada" class="about-avatar about-photo" width="80" height="80" />
          : <div class="about-avatar">YA</div>
        }
        <div class="about-intro">
          <h1 class="about-title">Yassine Oulada</h1>
          <p class="about-role">GEO & SEO Spezialist · Performance Marketing Manager · Freelancer</p>
        </div>
      </div>

      <div class="about-bio">
        <p>Ich bin Performance Marketing Manager mit <strong>mehrjähriger Erfahrung im Performance Marketing</strong>, Agenturerfahrung und zusätzlich als Freelancer tätig — spezialisiert auf Generative Engine Optimization (GEO), SEO und Website-Relaunches. Dabei habe ich zahlreiche <strong>B2B-Unternehmen betreut</strong>: vom Mittelständler mit regionalem Fokus bis zur international ausgerichteten Website mit mehrsprachigen Auftritten.</p>
        <p>SimplyGEO ist mein Ort, um Wissen zu teilen, das ich in echten Projekten gesammelt habe. Keine Theorie von der Seitenlinie — sondern Praxis aus GEO-Audits, Website-Relaunches und täglicher Arbeit mit KI-Suchsystemen wie ChatGPT Search, Perplexity und Google AI Overviews.</p>
        <p>Was mich antreibt, sind <strong>messbare Ergebnisse</strong>: Sichtbarkeit, die sich in Zahlen zeigt, nicht in Versprechen. Die Zahlen unten stammen aus realen Kundenprojekten — und genau diese Arbeitsweise findest du auch in jedem Artikel auf dieser Website wieder.</p>
      </div>

      <!-- Stats -->
      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-card">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
            <div class="stat-desc">{s.desc}</div>
          </div>
        ))}
      </div>

      <!-- Skills -->
      <div class="skills-section">
        <h2 class="section-title">Skills & Tools</h2>
        <div class="skills-list">
          {skills.map(s => (
            <span class="skill-chip">{s}</span>
          ))}
        </div>
      </div>

      <!-- Was dich erwartet -->
      <div class="expect-section">
        <h2 class="section-title">Was dich hier erwartet</h2>
        <div class="expect-grid">
          <div class="expect-card">
            <span class="expect-icon">🎯</span>
            <h3>Praxisnahes Wissen</h3>
            <p>Kein akademisches Bla-bla. Alles, was ich hier schreibe, habe ich in echten Projekten erprobt und gemessen.</p>
          </div>
          <div class="expect-card">
            <span class="expect-icon">🇩🇪</span>
            <h3>DACH-Fokus</h3>
            <p>Inhalte, die die Besonderheiten des deutschsprachigen Markts berücksichtigen — Sprache, Datenschutz, Nutzerverhalten.</p>
          </div>
          <div class="expect-card">
            <span class="expect-icon">🔄</span>
            <h3>Aktuell bleiben</h3>
            <p>GEO ist ein schnelles Feld. Ich halte die Inhalte aktuell, wenn sich KI-Systeme und Best Practices weiterentwickeln.</p>
          </div>
        </div>
      </div>

      <!-- Zusammenarbeit -->
      <div class="collab-section">
        <h2 class="section-title">Zusammenarbeit</h2>
        <p class="collab-text">Du brauchst einen GEO-Audit, Unterstützung bei einem Website-Relaunch oder strategische Beratung zur KI-Sichtbarkeit? Ich freue mich über eine Nachricht.</p>
        <a href="https://www.linkedin.com/in/yassine-o-726988196/" target="_blank" rel="noopener noreferrer" class="linkedin-btn">
          LinkedIn → Yassine Oulada
        </a>
      </div>

    </div>
  </main>
  <Footer />
</Base>
<style>
.about-main{ position:relative; z-index:1; padding:40px 24px 60px; }
.about-inner{ max-width:720px; margin:0 auto; }
.eyebrow{ font-size:0.67rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent); margin-bottom:20px; display:block; }

.about-hero{ display:flex; align-items:center; gap:20px; margin-bottom:28px; flex-wrap:wrap; }
.about-avatar{
  width:80px; height:80px; border-radius:50%; flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--purple));
  display:flex; align-items:center; justify-content:center;
  font-family:'Space Grotesk',sans-serif; font-size:1.6rem; font-weight:700; color:#1e3d59;
}
.about-photo{ object-fit:cover; background:none; border:2px solid var(--border2); }
.about-title{ font-family:'Space Grotesk',sans-serif; font-size:1.8rem; font-weight:700; letter-spacing:-0.02em; color:var(--text); margin-bottom:4px; }
.about-role{ font-size:0.85rem; color:var(--accent); }

.about-bio{ margin-bottom:36px; }
.about-bio p{ font-size:0.92rem; color:var(--muted); line-height:1.75; margin-bottom:14px; }
.about-bio strong{ color:var(--text); }

/* Stats */
.stats-grid{ display:grid; gap:10px; margin-bottom:36px; }
@media(min-width:640px){ .stats-grid{ grid-template-columns:repeat(3,1fr); } }
.stat-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px; text-align:center; }
.stat-value{ font-family:'Space Grotesk',sans-serif; font-size:1.8rem; font-weight:700; color:var(--accent); margin-bottom:4px; }
.stat-label{ font-size:0.8rem; font-weight:600; color:var(--text); margin-bottom:4px; }
.stat-desc{ font-size:0.72rem; color:var(--muted); }

/* Skills */
.skills-section{ margin-bottom:36px; }
.section-title{ font-family:'Space Grotesk',sans-serif; font-size:1.1rem; font-weight:700; color:var(--text); margin-bottom:14px; }
.skills-list{ display:flex; flex-wrap:wrap; gap:8px; }
.skill-chip{ font-size:0.75rem; font-weight:600; color:var(--accent); background:rgba(226,85,42,0.1); border:1px solid rgba(226,85,42,0.25); padding:5px 12px; border-radius:20px; }

/* Was dich erwartet */
.expect-section{ margin-bottom:36px; }
.expect-grid{ display:grid; gap:10px; }
@media(min-width:640px){ .expect-grid{ grid-template-columns:repeat(3,1fr); } }
.expect-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px; }
.expect-icon{ font-size:1.4rem; display:block; margin-bottom:8px; }
.expect-card h3{ font-family:'Space Grotesk',sans-serif; font-size:0.9rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.expect-card p{ font-size:0.78rem; color:var(--muted); line-height:1.55; }

/* Zusammenarbeit */
.collab-section{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:24px; }
.collab-text{ font-size:0.88rem; color:var(--muted); line-height:1.65; margin-bottom:16px; }
.linkedin-btn{
  display:inline-flex; align-items:center; gap:8px;
  font-size:0.85rem; font-weight:600; color:var(--bg);
  background:#0077b5; padding:10px 20px; border-radius:var(--radius-sm);
  transition:opacity 0.2s;
}
.linkedin-btn:hover{ opacity:0.88; }
</style>
