---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const authorPhotoPath = '/images/yassine-oulada.jpg';
const hasAuthorPhoto = fs.existsSync(path.join(process.cwd(), 'public', authorPhotoPath));

const stats = [
  { value: 'SEO → GEO', label: 'Mein Weg', desc: 'vom klassischen Performance Marketing zur KI-Suche' },
  { value: 'B2B', label: 'Berufsalltag', desc: 'Agentur- und Kundenerfahrung, vom Mittelständler bis zur internationalen Website' },
  { value: '36', label: 'Prüfpunkte', desc: 'in der kostenlosen GEO-Checkliste zum Download' },
];

const skills = ['GEO', 'AEO', 'SEO', 'SEA', 'MODX', 'WordPress', 'GA4', 'GSC', 'Matomo', 'Schema Markup', 'Content-Strategie'];
---
<Base title="Über Yassine Oulada" description="Yassine Oulada ist Performance Marketing Manager und GEO-Spezialist im DACH-Markt. Hier erfährst du mehr über SimplyGEO.">
  <script type="application/ld+json" is:inline slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Yassine Oulada",
    "jobTitle": "GEO & SEO Spezialist · Performance Marketing Manager",
    "description": "Performance Marketing Manager mit mehrjähriger Berufs- und Agenturerfahrung, spezialisiert auf SEO, SEA und Website-Relaunches. Betreut B2B-Unternehmen und internationale Websites. Erschließt Generative Engine Optimization (GEO) systematisch und dokumentiert den Weg offen auf SimplyGEO.",
    "url": "https://simplygeo.de/about",
    "image": hasAuthorPhoto ? `https://simplygeo.de${authorPhotoPath}` : undefined,
    "knowsAbout": ["Generative Engine Optimization", "Answer Engine Optimization", "SEO", "SEA", "Schema Markup", "Content-Strategie"],
    "sameAs": ["https://www.linkedin.com/in/yassine-o-726988196/"],
    "mainEntityOfPage": "https://simplygeo.de/about"
  })} />
  <Header />
  <main id="main" class="about-main">
    <div class="about-inner">

      <span class="eyebrow">Über SimplyGEO</span>

      <div class="about-hero">
        {hasAuthorPhoto
          ? <img src={authorPhotoPath} alt="Yassine Oulada" class="about-avatar about-photo" width="80" height="80" />
          : <div class="about-avatar">YA</div>
        }
        <div class="about-intro">
          <h1 class="about-title">Yassine Oulada</h1>
          <p class="about-role">GEO & SEO Spezialist · Performance Marketing Manager</p>
        </div>
      </div>

      <div class="about-bio">
        <p>Ich bin Performance Marketing Manager mit <strong>mehrjähriger Berufs- und Agenturerfahrung</strong>, spezialisiert auf SEO, SEA und Website-Relaunches. Dabei habe ich zahlreiche <strong>B2B-Unternehmen betreut</strong>: vom Mittelständler mit regionalem Fokus bis zur international ausgerichteten Website mit mehrsprachigen Auftritten.</p>
        <p>Und dann kam GEO. Vor einigen Monaten habe ich angefangen, mich intensiv mit KI-Suchsystemen wie ChatGPT Search, Perplexity und Google AI Overviews zu beschäftigen, und schnell gemerkt: Hier verschiebt sich gerade etwas Grundlegendes. Inzwischen habe ich meine ersten eigenen <strong>GEO-Audits</strong> durchgeführt und baue mir das Thema systematisch auf, mit meinem SEO-Fundament als Basis.</p>
        <p>SimplyGEO ist mein Ort, um diesen Weg <strong>offen zu dokumentieren</strong>. Ich schreibe hier nicht als jemand, der seit zehn Jahren GEO macht, das tut nämlich niemand ehrlich, dafür ist das Feld zu jung. Ich schreibe als Marketing-Profi, der gerade tief einsteigt, gründlich recherchiert und teilt, was er dabei lernt.</p>
      </div>

      <!-- Stats -->
      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-card">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
            <div class="stat-desc">{s.desc}</div>
          </div>
        ))}
      </div>

      <!-- Skills -->
      <div class="skills-section">
        <h2 class="section-title">Skills & Tools</h2>
        <div class="skills-list">
          {skills.map(s => (
            <span class="skill-chip">{s}</span>
          ))}
        </div>
      </div>

      <!-- Was dich erwartet -->
      <div class="expect-section">
        <h2 class="section-title">Was dich hier erwartet</h2>
        <div class="expect-grid">
          <div class="expect-card">
            <span class="expect-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>
            </span>
            <h3>Ehrliches Wissen</h3>
            <p>Kein akademisches Bla-bla. Ich schreibe nur über Dinge, die ich selbst ausprobiert oder gründlich recherchiert habe, und sage dazu, was davon eigene Erfahrung ist.</p>
          </div>
          <div class="expect-card">
            <span class="expect-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>
            </span>
            <h3>DACH-Fokus</h3>
            <p>Inhalte, die die Besonderheiten des deutschsprachigen Markts berücksichtigen: Sprache, Datenschutz, Nutzerverhalten.</p>
          </div>
          <div class="expect-card">
            <span class="expect-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 4v4h-4"/></svg>
            </span>
            <h3>Aktuell bleiben</h3>
            <p>GEO ist ein schnelles Feld. Ich halte die Inhalte aktuell, wenn sich KI-Systeme und Best Practices weiterentwickeln.</p>
          </div>
        </div>
      </div>

      <!-- Zusammenarbeit -->
      <div class="collab-section">
        <h2 class="section-title">Austausch & Vernetzen</h2>
        <p class="collab-text">Du hast Fragen zu GEO, hängst bei einem konkreten Problem fest oder willst dich einfach zum Thema KI-Suche austauschen? Schreib mir gern, ich helfe, wo ich kann, und freue mich über jede Vernetzung.</p>
        <a href="https://www.linkedin.com/in/yassine-o-726988196/" target="_blank" rel="noopener noreferrer" class="linkedin-btn">
          LinkedIn → Yassine Oulada
        </a>
      </div>

    </div>
  </main>
  <Footer />
</Base>
<style>
.about-main{ position:relative; z-index:1; padding:40px 24px 60px; }
.about-inner{ max-width:720px; margin:0 auto; }

.about-hero{ display:flex; align-items:center; gap:20px; margin-bottom:28px; flex-wrap:wrap; }
.about-avatar{
  width:84px; height:84px; border-radius:50%; flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--mango));
  display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-size:1.7rem; font-weight:700; color:var(--navy);
}
.about-photo{ object-fit:cover; background:none; border:2px solid var(--border2); }
.about-title{ font-family:var(--font-display); font-size:2.1rem; font-weight:700; letter-spacing:-0.03em; color:var(--navy); margin-bottom:6px; }
.about-role{ font-family:var(--font-mono); font-size:0.76rem; color:var(--accent-deep); }

.about-bio{ margin-bottom:40px; }
.about-bio p{ font-size:0.98rem; color:#34495d; line-height:1.75; margin-bottom:15px; }
.about-bio strong{ color:var(--navy); }

/* Stats */
.stats-grid{ display:grid; gap:12px; margin-bottom:40px; }
@media(min-width:640px){ .stats-grid{ grid-template-columns:repeat(3,1fr); } }
.stat-card{ background:var(--navy); border-radius:var(--radius); padding:22px 20px; }
.stat-value{ font-family:var(--font-display); font-size:2.2rem; font-weight:700; letter-spacing:-0.02em; color:var(--mango); margin-bottom:6px; line-height:1; }
.stat-label{ font-size:0.82rem; font-weight:600; color:var(--on-navy-text); margin-bottom:4px; }
.stat-desc{ font-size:0.74rem; color:var(--on-navy-muted); line-height:1.45; }

/* Skills */
.skills-section{ margin-bottom:40px; }
.section-title{ font-family:var(--font-display); font-size:1.3rem; font-weight:700; letter-spacing:-0.02em; color:var(--navy); margin-bottom:16px; }
.skills-list{ display:flex; flex-wrap:wrap; gap:8px; }
.skill-chip{ font-family:var(--font-mono); font-size:0.74rem; font-weight:500; color:var(--navy); background:var(--surface); border:1px solid var(--border2); padding:5px 11px; border-radius:5px; }

/* Was dich erwartet */
.expect-section{ margin-bottom:36px; }
.expect-grid{ display:grid; gap:10px; }
@media(min-width:640px){ .expect-grid{ grid-template-columns:repeat(3,1fr); } }
.expect-card{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:18px; }
.expect-icon{
  display:flex; align-items:center; justify-content:center;
  width:40px; height:40px; margin-bottom:10px;
  color:var(--accent-deep); border-radius:10px;
  background:var(--accent-dim);
  border:1px solid rgba(255,110,64,0.22);
}
.expect-icon svg{ width:20px; height:20px; }
.expect-card h3{ font-family:var(--font-display); font-size:0.9rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.expect-card p{ font-size:0.78rem; color:var(--muted); line-height:1.55; }

/* Zusammenarbeit */
.collab-section{ background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:24px; }
.collab-text{ font-size:0.88rem; color:var(--muted); line-height:1.65; margin-bottom:16px; }
.linkedin-btn{
  display:inline-flex; align-items:center; gap:8px;
  font-size:0.85rem; font-weight:600; color:var(--bg);
  background:#0077b5; padding:10px 20px; border-radius:var(--radius-sm);
  transition:opacity 0.2s;
}
.linkedin-btn:hover{ opacity:0.88; }
</style>
