---
const nav = [
  { label: 'Themen', href: '/#topics', match: '/themen' },
  { label: 'Blog', href: '/blog', match: '/blog' },
  { label: 'Glossar', href: '/glossar', match: '/glossar' },
  { label: 'About', href: '/about', match: '/about' },
];
const currentPath = Astro.url.pathname;
const isActive = (item: typeof nav[0]) =>
  currentPath === item.href || currentPath.startsWith(item.match);
---
<a href="#main" class="skip-link">Zum Inhalt springen</a>
<header class="header">
  <a href="/" class="logo" aria-label="SimplyGEO Startseite">
    <svg class="logo-mark" viewBox="9 8 30 40" aria-hidden="true" fill="none">
      <path d="M35 13 H21 A7.5 7.5 0 0 0 21 28 H27 A7.5 7.5 0 0 1 27 43 H13" stroke="#f5f0e1" stroke-width="7" stroke-linecap="butt" stroke-linejoin="round"/>
      <path d="M19 18.5 L24 24 L19 29.5" stroke="#b3bcc8" stroke-width="3.4" stroke-linecap="butt" stroke-linejoin="miter"/>
      <path d="M23.5 18.5 L28.5 24 L23.5 29.5" stroke="#ff6e40" stroke-width="3.4" stroke-linecap="butt" stroke-linejoin="miter"/>
    </svg><span class="logo-text" aria-hidden="true">imply<span>GEO</span></span>
  </a>

  <nav class="nav" aria-label="Hauptnavigation">
    {nav.map(n => (
      <a href={n.href} class={`nav-link${isActive(n) ? ' active' : ''}`} aria-current={isActive(n) ? 'page' : undefined}>{n.label}</a>
    ))}
  </nav>

  <a href="/downloads/geo-checkliste.pdf" class="dl-btn" download>
    <svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>
    GEO-Checkliste
  </a>

  <!-- Mobile menu (CSS-only) -->
  <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" />
  <label for="menu-toggle" class="burger" aria-label="Menü öffnen">
    <span></span><span></span><span></span>
  </label>
  <nav class="mobile-nav" aria-label="Mobile Navigation">
    {nav.map(n => (
      <a href={n.href} class={`mobile-link${isActive(n) ? ' active' : ''}`}>{n.label}</a>
    ))}
    <a href="/downloads/geo-checkliste.pdf" class="mobile-link mobile-dl" download>
      <svg class="icon-inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>
      GEO-Checkliste laden
    </a>
  </nav>
</header>

<style>
.header {
  position: sticky; top: 0; z-index: 200;
  height: 56px; display: flex; align-items: center;
  justify-content: space-between; gap: 16px;
  padding: 0 24px;
  background: var(--navy);
  border-bottom: 1px solid var(--navy-soft);
}
.logo {
  display: inline-flex; align-items: center; gap: 0;
  font-family: var(--font-display);
  font-size: 1.15rem; font-weight: 700;
  letter-spacing: -0.03em; white-space: nowrap;
  color: var(--on-navy-text);
}
.logo-mark { height: 27px; width: auto; flex-shrink: 0; margin-right: 4px; }
.logo-text span { color: var(--accent); }
.nav { display: none; align-items: center; gap: 2px; }
@media (min-width: 768px) { .nav { display: flex; } }
.nav-link {
  font-size: 0.85rem; color: var(--on-navy-muted);
  padding: 6px 12px; border-radius: var(--radius-sm);
  transition: color 0.15s, background 0.15s;
}
.nav-link:hover { color: var(--on-navy-text); }
.nav-link.active { color: var(--mango); }
.dl-btn {
  display: none;
  font-family: var(--font-display);
  font-size: 0.78rem; font-weight: 700; color: var(--navy);
  background: var(--mango); border: 1px solid var(--mango);
  border-radius: var(--radius-sm); padding: 7px 14px; white-space: nowrap;
  transition: background 0.2s, border-color 0.2s;
}
@media (min-width: 768px) { .dl-btn { display: inline-block; } }
.dl-btn:hover { background: var(--accent); border-color: var(--accent); }

/* ── Mobile menu ── */
.menu-toggle { display: none; }
.burger {
  display: flex; flex-direction: column; justify-content: center; gap: 4px;
  width: 36px; height: 36px; padding: 8px;
  cursor: pointer; border-radius: var(--radius-sm);
  transition: background 0.15s;
}
.burger:hover { background: var(--navy-soft); }
.burger span {
  display: block; height: 2px; width: 100%;
  background: var(--on-navy-text); border-radius: 1px;
  transition: transform 0.2s, opacity 0.2s;
}
@media (min-width: 768px) { .burger { display: none; } }

.menu-toggle:checked ~ .burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.menu-toggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
.menu-toggle:checked ~ .burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

.mobile-nav {
  display: none;
  position: absolute; top: 56px; left: 0; right: 0;
  flex-direction: column;
  background: var(--navy);
  border-bottom: 1px solid var(--navy-soft);
  padding: 8px 16px 16px;
}
.menu-toggle:checked ~ .mobile-nav { display: flex; }
@media (min-width: 768px) { .mobile-nav { display: none !important; } }

.mobile-link {
  font-size: 0.95rem; font-weight: 500; color: var(--on-navy-muted);
  padding: 12px 8px; border-bottom: 1px solid var(--navy-soft);
  transition: color 0.15s;
}
.mobile-link:hover, .mobile-link.active { color: var(--on-navy-text); }
.mobile-dl { color: var(--mango); border-bottom: none; font-weight: 600; }
</style>
