---
const year = new Date().getFullYear();

const themen = [
  { label: 'GEO Grundlagen', href: '/themen/geo' },
  { label: 'AEO & Answer Engines', href: '/themen/aeo' },
  { label: 'LLM & KI-Suchmaschinen', href: '/themen/llm' },
  { label: 'Strukturierte Daten', href: '/themen/schema' },
  { label: 'Content & E-E-A-T', href: '/themen/content' },
  { label: 'Tools & Messung', href: '/themen/tools' },
];
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">

      <div class="footer-brand">
        <span class="footer-logo">Simply<span>GEO</span></span>
        <p class="footer-desc">GEO, AEO und KI-Suche für den DACH-Markt, praxisnah erklärt von Yassine Oulada.</p>
        <a href="https://www.linkedin.com/in/yassine-o-726988196/" target="_blank" rel="noopener noreferrer" class="footer-social">
          LinkedIn ↗
        </a>
      </div>

      <nav class="footer-col" aria-label="Themenbereiche">
        <div class="footer-col-title">Themen</div>
        {themen.map(t => (
          <a href={t.href}>{t.label}</a>
        ))}
      </nav>

      <nav class="footer-col" aria-label="Inhalte">
        <div class="footer-col-title">Inhalte</div>
        <a href="/blog">Alle Artikel</a>
        <a href="/blog/was-ist-geo">Einstieg: Was ist GEO?</a>
        <a href="/glossar">GEO-Glossar</a>
        <a href="/about">Über Yassine</a>
        <a href="/downloads/geo-checkliste.pdf" download>GEO-Checkliste (PDF)</a>
      </nav>

      <nav class="footer-col" aria-label="Rechtliches">
        <div class="footer-col-title">Rechtliches</div>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>

    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© {year} SimplyGEO · simplygeo.de</p>
      <p class="footer-note">Keine Cookies, kein Tracking — versprochen.</p>
    </div>
  </div>
</footer>

<style>
.footer {
  border-top: 3px solid var(--accent);
  padding: 48px 24px 28px;
  position: relative; z-index: 1;
  background: var(--navy);
  color: var(--on-navy-text);
}
.footer-inner { max-width: 1100px; margin: 0 auto; }

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  margin-bottom: 36px;
}
@media (min-width: 640px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 900px) { .footer-grid { grid-template-columns: 2fr 1.2fr 1.2fr 0.8fr; gap: 40px; } }

.footer-logo {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.1rem; font-weight: 700;
  color: var(--on-navy-text);
}
.footer-logo span { color: var(--accent); }
.footer-desc {
  font-size: 0.8rem; color: var(--on-navy-muted);
  line-height: 1.6; margin-top: 10px; margin-bottom: 14px;
  max-width: 280px;
}
.footer-social {
  display: inline-block;
  font-size: 0.75rem; font-weight: 700; color: var(--navy);
  background: var(--mango);
  padding: 5px 12px;
  border: 1px solid var(--mango); border-radius: 20px;
  transition: background 0.15s, border-color 0.15s;
}
.footer-social:hover { background: var(--accent); border-color: var(--accent); }

.footer-col { display: flex; flex-direction: column; gap: 8px; }
.footer-col-title {
  font-size: 0.65rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--mango); margin-bottom: 4px;
}
.footer-col a {
  font-size: 0.8rem; color: var(--on-navy-muted);
  transition: color 0.15s;
  width: fit-content;
}
.footer-col a:hover { color: var(--on-navy-text); }

.footer-bottom {
  display: flex; justify-content: space-between; align-items: center;
  gap: 12px; flex-wrap: wrap;
  padding-top: 20px;
  border-top: 1px solid var(--navy-soft);
}
.footer-copy { font-size: 0.72rem; color: var(--on-navy-muted); }
.footer-note { font-size: 0.72rem; color: var(--on-navy-muted); }
</style>
