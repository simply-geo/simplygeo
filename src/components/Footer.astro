---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">Simply<span>GEO</span></span>
      <p class="footer-desc">GEO, AEO und KI-Suche für den DACH-Markt — praxisnah erklärt.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer Navigation">
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </nav>
    <p class="footer-copy">© {year} SimplyGEO · simplygeo.de</p>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--border);
  padding: 32px 24px;
  position: relative; z-index: 1;
}
.footer-inner {
  max-width: 900px; margin: 0 auto;
  display: flex; flex-direction: column; gap: 16px;
}
.footer-logo {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem; font-weight: 700;
}
.footer-logo span { color: var(--accent); }
.footer-desc { font-size: 0.78rem; color: var(--muted); margin-top: 4px; }
.footer-nav { display: flex; flex-wrap: wrap; gap: 4px; }
.footer-nav a {
  font-size: 0.75rem; color: var(--muted);
  padding: 3px 8px; border-radius: 6px;
  transition: color 0.15s, background 0.15s;
}
.footer-nav a:hover { color: var(--text); background: var(--surface2); }
.footer-copy { font-size: 0.7rem; color: var(--muted2); }
</style>
